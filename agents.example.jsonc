// ─────────────────────────────────────────────────────────────────────────────
//  .vibe/agents.json — внешние агенты проекта (формат VibeIDE)
//
//  Это ПРИМЕР. Чтобы включить — скопируйте нужные блоки в файл .vibe/agents.json
//  рядом с этим (или переименуйте копию). Формат — JSONC: можно писать // комментарии.
//
//  Зачем: описывает, кого можно позвать в эту рабочую папку кроме собственного
//  агента VibeIDE. Внешний агент запускается отдельным процессом и говорит с IDE
//  на ACP (Agent Client Protocol) — спрашивает разрешение перед правкой, а IDE
//  снимает по его правкам чекпоинт и пишет их в журнал.
//  Нет файла — внешних агентов нет; всё остальное работает как раньше.
//
//  Не хотите писать руками — попросите агента в чате:
//    «Создай мне .vibe/agents.json для этого проекта»
//  (полная спека формата — docs/manuals/agentsSpec.md, её можно скормить любой LLM).
//
//  Главные принципы:
//   • "id" + "command" — единственные обязательные поля.
//   • Команда запускается НАПРЯМУЮ, без оболочки: аргументы перечисляются
//     по одному в "args", а не пишутся строкой в "command".
//   • Агент должен уметь ACP. Обычный CLI сюда не годится: у большинства
//     инструментов режим ACP даёт отдельный адаптер (см. пример ниже).
//   • Одна битая запись не роняет реестр — пропускается с предупреждением.
//   • "active": false оставляет запись документированной, но вне списка.
// ─────────────────────────────────────────────────────────────────────────────
{
	"version": 1,
	"agents": [
		// ─── Claude Code через официальный ACP-адаптер ──────────────────────
		// Требует входа: выполните `claude /login` в терминале один раз.
		// Сам `claude` разговаривать по ACP не умеет — адаптер обязателен.
		{
			"id": "claude",
			"name": "Claude Code",
			"command": "npx",
			"args": ["-y", "@agentclientprotocol/claude-agent-acp"]
		},

		// ─── Cursor Agent (нативный режим ACP) ──────────────────────────────
		// Адаптер не нужен: CLI Cursor умеет ACP сам. Бинарь называется `agent`
		// (он ставится вместе с приложением Cursor, обычно ~/.local/bin/agent),
		// подкоманда — `acp`. Ключ передаётся флагом ДО подкоманды, поэтому в
		// "args" он идёт первым: ["--api-key", "…", "acp"].
		// Режимы agent / plan / ask — это штатные режимы сессии ACP: переключаются
		// пикером над композером, plan и ask доступны только на чтение.
		// MCP-серверы берутся из .cursor/mcp.json (проектный и пользовательский);
		// серверы уровня команды из дашборда Cursor в режиме ACP НЕ подхватываются.
		// Вход: `cursor login` один раз в терминале. Ключ в файл репозитория не
		// пишите — либо вход, либо CURSOR_API_KEY в окружении машины и запись вида
		// "args": ["--api-key", "$CURSOR_API_KEY", "acp"] в СВОЁМ agents.json.
		// Источник: cursor.com/docs/cli/acp (проверено 08.09.2026).
		{
			"id": "cursor",
			"name": "Cursor Agent",
			"command": "agent",
			"args": ["acp"],
			"active": false
		},

		// ─── OpenHands (нативный режим ACP) ─────────────────────────────────
		// Адаптер не нужен: CLI OpenHands умеет ACP сам, подкоманда — `acp`.
		// Ставится отдельно (CLI OpenHands), после установки один раз запустите
		// `openhands` и через `/settings` выберите LLM-провайдера и ключ — ACP-режим
		// берёт настройки оттуда, поэтому ключ в этот файл писать не нужно.
		// Источник: openhands.dev/blog/20251209-use-openhands-in-your-ide-with-acp
		// и zed.dev/acp/agent/openhands (проверено 09.09.2026).
		{
			"id": "openhands",
			"name": "OpenHands",
			"command": "openhands",
			"args": ["acp"],
			"active": false
		},

		// ─── Агент для одного пакета монорепо ───────────────────────────────
		// "dir" задаёт рабочую папку относительно корня проекта: агент увидит
		// её как свой корень и не полезет в соседние пакеты.
		{
			"id": "web",
			"name": "Claude Code (web)",
			"command": "npx",
			"args": ["-y", "@agentclientprotocol/claude-agent-acp"],
			"dir": "packages/web",
			"active": false
		},

		// ─── Свой агент с переменными окружения ─────────────────────────────
		// "env" кладётся поверх унаследованного окружения. Ключи в файл
		// репозитория не пишите — передавайте имя переменной, а значение
		// держите в окружении машины.
		{
			"id": "custom",
			"name": "Собственный ACP-агент",
			"command": "/usr/local/bin/my-acp-agent",
			"args": ["--stdio"],
			"env": { "MY_AGENT_PROFILE": "project" },
			"active": false
		}
	]
}
