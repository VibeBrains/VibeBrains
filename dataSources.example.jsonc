// ─────────────────────────────────────────────────────────────────────────────
//  .vibe/dataSources.json — подключения к базам данных (VibeIDEA)
//
//  Это ПРИМЕР. Чтобы включить: скопируйте в .vibe/dataSources.json (строгий JSON,
//  без комментариев). Панель — «БД» справа.
//
//  ПАРОЛЯ ЗДЕСЬ НЕТ И БЫТЬ НЕ МОЖЕТ: файл едет в git, а пароль в git — это утечка
//  с отложенным сроком. Пароль хранится в связке ключей системы; поле "password"
//  в этом файле панель покажет красной строкой как находку, а не как настройку.
//
//  Драйверы JDBC не поставляются с IDE (у них разные лицензии) — скачайте jar и
//  укажите путь в driverPath. Таблица драйверов и лицензий — в спеке.
//  Полная спека: docs/vibe/manuals/dataSourcesSpec.md
// ─────────────────────────────────────────────────────────────────────────────
{
  "dataSources": [
    {
      "id": "local",
      "name": "Локальная разработка",
      "url": "jdbc:postgresql://localhost:5432/app",
      "user": "app",
      "driverPath": "~/drivers/postgresql-42.7.11.jar"
    },
    {
      // SQLite не требует ни сервера, ни пользователя — путь к файлу и всё.
      "id": "sqlite",
      "name": "Файл базы рядом с проектом",
      "url": "jdbc:sqlite:./dev.db",
      "driverPath": "~/drivers/sqlite-jdbc-3.53.2.1.jar"
    }
  ]
}
