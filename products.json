// ─────────────────────────────────────────────────────────────────────────────
//  products.json — кто читает этот набор и какой файл кому адресован.
//
//  СЛУЖЕБНЫЙ файл набора: в проекты не засевается, как versions.json и deprecated.json.
//  Рукописный — в отличие от versions.json, который генерирует bump.mjs.
//  Формат JSONC: комментарии и висячие запятые разрешены.
//
//  ── "products" — словарь известных продуктов ──────────────────────────────
//  Стабильные id в нижнем регистре. Список ОБЩИЙ, и в этом весь смысл: строгую проверку
//  делает тест набора, а тест сверяется со списком — если список каждый держит свой, они
//  разойдутся молча. Это буквально механика, сломавшая цену под `cost*`, только вместо
//  имени поля имя продукта.
//  Рантайм продукта про незнакомый id МОЛЧИТ — это совместимость вперёд, и трогать её
//  незачем: сборка, выпущенная сегодня, увидит запись для продукта, которого ещё нет.
//  Отсюда разделение: рантайм мягкий, тест набора строгий.
//
//  ── "files" — адресация файлов ────────────────────────────────────────────
//  Пути в списке нет — файл для всех, и так почти всегда. Нужен затем, что продукт не
//  должен РАЗБИРАТЬ файл, чтобы узнать, что файл не для него: `patrols.json` в продукте
//  без панели дежурных проверок не «выключен», а бессмысленен целиком, и засевать его
//  туда незачем.
//  Внутри файла тот же смысл у отдельной ЗАПИСИ несёт её поле "products". Два уровня не
//  заменяют друг друга: запись бывает чужой в общем файле, файл бывает чужим целиком.
//
//  ВАЖНО про совместимость: поле не защищает от старых сборок. Сборка, которая о нём ещё
//  не знает, поле игнорирует и запись ВЫПОЛНЯЕТ. Поэтому адресная запись едет вместе с
//  "active": false, пока не должна работать везде.
// ─────────────────────────────────────────────────────────────────────────────
{
  "version": 1,
  "products": ["vibeide", "vibeidea", "vibecli"],
  "files": [
    // Обе панели существуют только в VibeIDEA — соседям эти файлы не «выключать надо»,
    // их незачем засевать вовсе (сказано VibeIDE 09.09.2026).
    { "path": "patrols.json", "products": ["vibeidea"] },
    { "path": "dataSources.json", "products": ["vibeidea"] },
    // Тестовые данные, а не сид: общие векторы разбора остатка подписки (поле quota). Их читают
    // тесты обоих продуктов прямо из набора; в проекты не засевается никому — отсюда пустой список
    // (решение VibeIDE 17.09.2026: векторы в одном месте, а не копией у каждого продукта).
    { "path": "testVectors/subscriptionQuota.json", "products": [] },
    // Каталог примет нейрослопа: продукт читает его ИЗ СБОРКИ, в проекты не засевается никому.
    // Засеянная копия заморозила бы списки, как засеянный файл базового языка — формулировки.
    { "path": "slop/catalog.jsonc", "products": [] },
    // Общие тестовые векторы детектора нейрослопа: один текст обязан давать в обоих продуктах одни и те же
    // находки и один счёт. Как subscriptionQuota.json — читают тесты, в проекты не засевается никому.
    { "path": "testVectors/textSlop.json", "products": [] },
    // Общие векторы авторизации провайдера: локальный адрес, место ключа, запрос каталога. Одна запись
    // providers.json обязана ходить к серверу в обоих продуктах одинаково. Читают тесты, в проекты не засевается.
    { "path": "testVectors/providerAuth.json", "products": [] },
    // Общие векторы логических имён моделей (routes): слои, запрет null, разворачивание. Читают тесты.
    { "path": "testVectors/modelRoutes.json", "products": [] },
    // Общие векторы возврата рассуждения: какие модели требуют его обратно и в какой форме на каждом проводе. Читают тесты.
    { "path": "testVectors/reasoningEcho.json", "products": [] },
    // Правки каталога в проекте. Детектор есть у VibeIDEA и VibeIDE (с 23.09.2026); продукту без детектора
    // файл бесполезен.
    { "path": "slop.json", "products": ["vibeidea", "vibeide"] },
    // Инструкция стиля «сжатые ответы» (по мотивам навыка Caveman, MIT): оба продукта читают её ИЗ СБОРКИ и отправляют
    // модели выбранный уровень; в проекты не засевается никому — засеянная копия заморозила бы текст, как каталог нейрослопа.
    { "path": "terse/replies.md", "products": [] },
    // Сценарии `/workflow:<имя>` читает только VibeIDE; навык, по которому сценарий действует (skills/demo), — общий.
    { "path": "workflows/demo.json", "products": ["vibeide"] }
  ]
}
