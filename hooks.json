// ─────────────────────────────────────────────────────────────────────────────
//  .vibe/hooks.json — хуки проекта (формат VibeIDE)
//
//  Это РАБОЧИЙ файл, а не пример: отдельного файла-двойника рядом больше нет. Все записи
//  ниже выключены ("active": false) — уберите поле у нужной, поправьте команду под свой
//  проект и включите настройку Settings → Tools → VibeIDEA → Агент → «Включить хуки проекта»
//  (без неё не работает ни один хук, даже включённый здесь: два выключателя намеренно —
//  хук запускает ваш код).
//  Комментарии писать МОЖНО: формат JSONC, как и у остальных конфигов .vibe.
//  Хук — команда ВАШЕГО проекта вокруг действий агента; её код выхода решает:
//  0 = разрешено (+stdout заметкой), 2 = отказ, прочее/таймаут = поломка хука (не блокирует).
//  Полная спека: docs/vibe/manuals/hooksSpec.md (можно скормить любой LLM).
// ─────────────────────────────────────────────────────────────────────────────
{
  "hooks": [
    // Детектор, а НЕ граница. Ловит запись и запуск по тексту — то есть ту форму, которую агент
    // обычно и пишет; переписанную или обёрнутую (`sh -c`, абсолютный путь) он не поймает.
    // Настоящую границу ставят права процесса и отсутствие токена в окружении. Смысл хука —
    // назвать действие вслух и оставить след в журнале.
    // Код выхода 2 = «не делай»; 0 = «можно». Включите, сняв "active": false.
    {
      "event": "preToolUse",
      "command": "jq -e -r '(.params.path // .params.command // \"\")' | grep -qiE '(^|/)\\.(ssh|aws|netrc|npmrc|pypirc)|(^|/)\\.env($|\\.)|\\.(pem|p12|keychain)$|gcloud/|docker/config\\.json' && exit 2 || exit 0",
      "label": "секреты не читаем",
      "active": false
    },
    {
      "event": "preToolUse",
      "command": "jq -e -r '(.params.command // \"\")' | grep -qE '(npm|yarn|pnpm) +publish|cargo +publish|twine +upload|gem +push|docker +push|gh +release +create' && exit 2 || exit 0",
      "label": "публикация — только руками",
      "active": false
    },
    // Сеть из терминала агента. Тоже детектор: python-сокет, `sh -c` и скрипт в файле он не увидит.
    // Повод — агент, вышедший из песочницы через DNS: вопросы в именах хостов, ответы TXT-записями
    // (alignment.openai.com/misalignment-reports, 25.09.2026). NCSC советует выпускать агента в сеть только
    // по списку разрешённых адресов (ncsc.gov.uk/blogs/managing-the-cyber-risk-of-agentic-ai) — список
    // держат права процесса и прокси, а хук называет попытку вслух.
    {
      "event": "preToolUse",
      "command": "jq -e -r '(.params.command // \"\")' | grep -qiE '(^|[;&|(` ])(curl|wget|nc|ncat|socat|telnet|ftp|scp|sftp|nslookup|dig|drill|host|Invoke-WebRequest|iwr|Invoke-RestMethod|irm)( |$)|/dev/(tcp|udp)/' && exit 2 || exit 0",
      "label": "сеть из терминала — только руками",
      "active": false
    },
    // Запись только внутри проекта: абсолютный путь вне корня или выход через `..` — отказ.
    // Имена инструментов записи у обеих IDE разные — перечислены все. Команды оболочки сюда не входят.
    // Пути Windows (C:\…) хук не разбирает: он о форме пути, которую агент пишет чаще всего.
    {
      "event": "preToolUse",
      "tools": ["edit_file", "rewrite_file", "create_file_or_folder", "delete_file_or_folder", "write_text_file"],
      "command": "jq -e '.cwd as $c | (.params.path // .params.uri // \"\") as $p | ($p | test(\"(^|/)\\\\.\\\\.(/|$)\")) or (($p | startswith(\"/\")) and $p != $c and (($p | startswith($c + \"/\")) | not))' >/dev/null && exit 2 || exit 0",
      "label": "запись только внутри проекта",
      "active": false
    },
    // preToolUse блокирует в точках, которыми владеет клиент: запрос разрешения и запись через fs/write.
    { "event": "preToolUse", "command": "node .vibe/hooks/no-migrations.js", "tools": ["write_text_file"], "label": "миграции только руками", "active": false },
    // postToolUse не отменяет сделанное — формулирует требование исправить.
    { "event": "postToolUse", "command": "npm run lint --silent", "tools": ["write_text_file"], "timeoutMs": 60000, "label": "линтер после записи", "active": false },
    // turnEnd срабатывает в конце хода; изменённые файлы приходят в stdin-JSON (changedFiles).
    { "event": "turnEnd", "command": "npm test --silent", "timeoutMs": 300000, "label": "тесты в конце хода", "active": false },
    // pipelineStepEnd — гейт приёмки между шагами пайплайна (каскад «дешёвая модель, потом
    // дорогая»). В stdin-JSON приходят pipeline, step, role, model и answer — ответ шага,
    // обрезанный. Код выхода 0 = «черновик принят», и шаги с "escalation": true пропускаются;
    // код 2 = «не принят», и они выполняются. Поле tools здесь не применяется.
    { "event": "pipelineStepEnd", "command": "node .vibe/hooks/accept-draft.js", "timeoutMs": 120000, "label": "гейт приёмки черновика", "active": false }
  ]
}
