// ─────────────────────────────────────────────────────────────────────────────
//  .vibe/slop.json — что считать нейрослопом в ЭТОМ проекте.
//  Читают VibeIDEA и VibeIDE: инструмент агента vibe_text_slop_check и правило текста страницы
//  copy-slop в дизайн-детекторе; у VibeIDEA ещё гейт хода и действие «Нейрослоп в тексте».
//
//  Это РАБОЧИЙ файл. Комментарии писать МОЖНО — формат JSONC.
//  Списки НАМЕРЕННО ПУСТЫ: общий каталог правил приезжает со сборкой, а здесь — только то,
//  чем этот проект от него отличается. Правка действует со следующей проверки.
//
//  ПОЛЯ:
//   • "disable": ["F5", "RU-D1"] — правила, которые здесь не действуют. Id правила написан
//     в каждой находке детектора.
//   • "allow": ["экосистем*"] — настоящие термины проекта: находка, чей текст целиком
//     совпал с таким словом, не считается. Звёздочка в конце слова — любое окончание.
//   • "rules": [...] — свои правила в формате каталога; правило с id из каталога заменяет его.
//     Пример: { "id": "P1", "lang": "ru", "kind": "phrases", "severity": "minor",
//               "name": "Своё", "fix": "Как сказать иначе", "items": ["в разрезе"] }
//   • "passScore": 90 — с какого счёта текст проходит проверку.
//
//  Строку, которую надо оставить как есть, отметьте в самом тексте:
//    <!-- slop-ignore RU-W2 — причина -->
//  Спека — slopSpec.md в документации продукта (VibeIDEA — docs/vibe/manuals, VibeIDE — docs/manuals);
//  в IDE её находит поиск по документации.
// ─────────────────────────────────────────────────────────────────────────────
{
  "version": 1,
  "disable": [],
  "allow": [],
  "rules": []
}
