// ─────────────────────────────────────────────────────────────────────────────
//  .vibe/pipelines.json — цепочки шагов-ролей (формат VibeIDE)
//
//  Это ПРИМЕР. Чтобы включить: скопируйте в .vibe/pipelines.json (строгий JSON,
//  без комментариев). Запуск — иконка «Пайплайн…» в композере чата.
//  Каждый шаг — отдельный ход агента со своей ролью; провал шага помечает
//  следующие как «пропущен» (если у них нет continueOnFailure).
//  Полная спека: docs/vibe/manuals/pipelinesSpec.md.
// ─────────────────────────────────────────────────────────────────────────────
{
  "version": 1,
  "pipelines": [
    {
      "id": "feature",                    // обязателен, уникален; по нему запуск
      "name": "Фича под ключ",
      "description": "Спроектировать, реализовать, проверить",
      "steps": [                          // 1..20 шагов, порядок = порядок выполнения
        { "role": "planner",       "task": "Разбей задачу на шаги и запиши план в docs/plan.md" },
        // Потолки шага: превышение прекращает ШАГ (не прогон). Считаются по тому, что сообщает
        // агент: maxTokens — по занятому контексту, maxSteps — по вызовам инструментов.
        // 0 или отсутствие поля значат «потолка нет».
        { "role": "backend-dev",   "task": "Реализуй по плану", "acceptance": "Проект собирается",
          "maxTokens": 120000, "maxSteps": 40 },
        { "role": "code-reviewer", "task": "Найди дефекты в изменениях", "ignorePreviousArtifacts": true }
      ]
    },

    // ─── Каскад: дешёвая модель, гейт, дорогая только если не приняли ──────────
    // Смысл каскада в том, что дорогой шаг выполняется НЕ ВСЕГДА. Решает это не модель
    // и не IDE, а ваш гейт — хук "pipelineStepEnd" в .vibe/hooks.json: код выхода 0 значит
    // «черновик принят» (шаги с "escalation": true пропускаются), код 2 — «не принят»
    // (они выполняются). Без такого хука принимать нечем, и эскалация идёт всегда.
    //
    // "provider" + "model" уводят шаг с ACP-агента на прямой запрос к модели: у такого шага
    // НЕТ инструментов и НЕТ доступа к файлам, поэтому он разрешён только ролям, которые и так
    // ничего не пишут (explore, planner, code-reviewer, qa, security, critic).
    // Экономия считается просто: доля прогонов, где гейт принял, умноженная на разницу цен.
    // Не забудьте про повторную подачу контекста дорогому шагу — она тоже в счёте.
    {
      "id": "cascade-review",
      "name": "Каскад: дешёвый ревьюер, дорогой критик",
      "description": "Ревью дешёвой моделью; если гейт не принял — критик из другого семейства",
      "steps": [
        { "role": "code-reviewer", "provider": "minimax", "model": "MiniMax-M3",
          "task": "Найди дефекты в изменениях последнего коммита. Кратко, по пунктам." },
        // Критик намеренно из ДРУГОГО семейства моделей: своей ошибки модель не видит по той же
        // причине, по которой её сделала. Это инженерная эвристика, а не доказанный факт.
        { "role": "critic", "provider": "anthropic", "model": "claude-fable-5-1", "escalation": true,
          "task": "Черновик ревью выше неполон. Назови, что в нём пропущено и что неверно." }
      ]
    }
  ]
}
