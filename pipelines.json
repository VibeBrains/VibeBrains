// ─────────────────────────────────────────────────────────────────────────────
//  .vibe/pipelines.json — цепочки шагов-ролей (формат VibeIDE)
//
//  Это РАБОЧИЙ файл, а не пример: файла-двойника рядом больше нет. Комментарии писать
//  МОЖНО — формат JSONC, как и у остальных конфигов .vibe.
//  Пайплайны запускаются только по кнопке, поэтому тумблера у них нет: лежащий здесь
//  пайплайн ничего не делает, пока его не выбрали. Запуск — иконка «Пайплайн…» в композере.
//  Каждый шаг — отдельный ход агента со своей ролью; провал шага помечает
//  следующие как «пропущен» (если у них нет continueOnFailure).
//  Полная спека: docs/vibe/manuals/pipelinesSpec.md.
// ─────────────────────────────────────────────────────────────────────────────
{
  "version": 1,
  "pipelines": [
    {
      "id": "feature",                    // обязателен, уникален; по нему запуск
      "name": "Фича под ключ",
      "description": "Спроектировать, реализовать, проверить",
      "steps": [                          // 1..20 шагов, порядок = порядок выполнения
        { "role": "planner",       "task": "Разбей задачу на шаги и запиши план в docs/plan.md" },
        // Потолки шага: превышение прекращает ШАГ (не прогон). Считаются по тому, что сообщает
        // агент: maxTokens — по занятому контексту, maxSteps — по вызовам инструментов.
        // 0 или отсутствие поля значат «потолка нет».
        { "role": "backend-dev",   "task": "Реализуй по плану", "acceptance": "Проект собирается",
          "maxTokens": 120000, "maxSteps": 40 },
        { "role": "code-reviewer", "task": "Найди дефекты в изменениях", "ignorePreviousArtifacts": true },
        // Знание переживает прогон: итог шага живёт до конца прогона и исчезает, а найденное по дороге
        // («как гонять тесты этого сервиса», грабля сборки) нужно следующему прогону. Шаг пишет ТОЛЬКО в
        // базу знаний — "paths" не пускает его в код, а нечего записать — пусть так и скажет.
        { "role": "implement-step", "task": "Если по дороге нашлось неочевидное (грабля, способ проверки, решение) — запиши в базу знаний проекта отдельной записью со строкой в её индексе. Нечего записать — так и скажи, не выдумывай",
          "paths": ["docs/knowledge/**", "docs/*/knowledge/**"], "continueOnFailure": true }
      ]
    },

    // ─── Роли, разведённые по каталогам ───────────────────────────────────────
    // "paths" и "denyPaths" — синтаксис .gitignore. Запреты проверяются ПЕРВЫМИ и сильнее
    // разрешений; порядок записей внутри списка ничего не меняет. Нет ни одного поля —
    // ограничения нет вовсе (шаг пишет куда угодно, как раньше).
    //   "tests/**"        — только дерево тестов
    //   "*.md"            — любой markdown на любом уровне (правило .gitignore для шаблона без /)
    //   "docs/"           — каталог целиком
    //   "**/secrets/**"   — типичный запрет
    // Права роли (ревьюер не пишет вовсе) действуют СВЕРХ этого: сузить можно, расширить нельзя.
    {
      "id": "feature-scoped",
      "name": "Фича с разделением по каталогам",
      "description": "Реализация, тесты и документация пишут каждый в своё",
      "steps": [
        { "role": "backend-dev", "task": "Реализуй возможность",
          "paths": ["src/**"], "denyPaths": ["**/secrets/**"] },
        { "role": "backend-dev", "task": "Покрой её тестами",
          "paths": ["tests/**", "**/testSrc/**"] },
        { "role": "backend-dev", "task": "Опиши её в документации",
          "paths": ["docs/**", "*.md"] },
        { "role": "code-reviewer", "task": "Проверь всё вместе", "ignorePreviousArtifacts": true }
      ]
    },

    // ─── Каскад: дешёвая модель, гейт, дорогая только если не приняли ──────────
    // Смысл каскада в том, что дорогой шаг выполняется НЕ ВСЕГДА. Решает это не модель
    // и не IDE, а ваш гейт — хук "pipelineStepEnd" в .vibe/hooks.json: код выхода 0 значит
    // «черновик принят» (шаги с "escalation": true пропускаются), код 2 — «не принят»
    // (они выполняются). Без такого хука принимать нечем, и эскалация идёт всегда.
    //
    // "model": "провайдер/модель" (одной строкой — так читают оба продукта; пара "provider" + "model" — устаревший синоним) уводит шаг с ACP-агента на прямой запрос к модели: у такого шага
    // НЕТ инструментов и НЕТ доступа к файлам, поэтому он разрешён только ролям, которые и так
    // ничего не пишут (explore, planner, code-reviewer, qa, security, critic).
    // Экономия считается просто: доля прогонов, где гейт принял, умноженная на разницу цен.
    // Не забудьте про повторную подачу контекста дорогому шагу — она тоже в счёте.
    {
      "id": "cascade-review",
      "name": "Каскад: дешёвый ревьюер, дорогой критик",
      "description": "Ревью дешёвой моделью; если гейт не принял — критик из другого семейства",
      "steps": [
        { "role": "code-reviewer", "model": "minimax/MiniMax-M3",
          "task": "Найди дефекты в изменениях последнего коммита. Кратко, по пунктам." },
        // Критик намеренно из ДРУГОГО семейства моделей: своей ошибки модель не видит по той же
        // причине, по которой её сделала. Это инженерная эвристика, а не доказанный факт.
        { "role": "critic", "model": "anthropic/claude-fable-5-1", "escalation": true,
          "task": "Черновик ревью выше неполон. Назови, что в нём пропущено и что неверно." }
      ]
    },
    {
      // Разделение по сложности без гейта: решения об устройстве — сильной модели, механические проверки —
      // дешёвой. В отличие от cascade-review дорогой шаг идёт всегда: он про архитектуру, а не про доработку
      // черновика. Модели заданы только ролям, которые ничего не пишут; реализует агент пайплайна.
      // Модели — пример: замените на те, к которым у вас есть ключи.
      "id": "split-by-difficulty",
      "name": "Сложное — сильной модели, механическое — дешёвой",
      "description": "План и критика устройства сильной моделью, реализация агентом, механическое ревью дешёвой моделью",
      "steps": [
        { "role": "planner", "model": "anthropic/claude-fable-5-1",
          "task": "Разбей задачу на шаги и назови решения об устройстве, которые придётся принять" },
        { "role": "backend-dev", "task": "Реализуй по плану" },
        { "role": "code-reviewer", "model": "minimax/MiniMax-M3",
          "task": "Механическая проверка изменений: стиль, соответствие плану, есть ли тесты. Кратко, по пунктам." },
        { "role": "critic", "model": "anthropic/claude-fable-5-1",
          "task": "Оцени устройство изменений: границы модулей, зависимости, что сломается при следующем шаге. Не стиль." }
      ]
    }
  ]
}
