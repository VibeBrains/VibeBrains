// ─────────────────────────────────────────────────────────────────────────────
//  .vibe/pipelines.json — цепочки шагов-ролей (формат VibeIDE)
//
//  Это РАБОЧИЙ файл, а не пример: файла-двойника рядом больше нет. Комментарии писать
//  МОЖНО — формат JSONC, как и у остальных конфигов .vibe.
//  Пайплайны запускаются только по кнопке, поэтому тумблера у них нет: лежащий здесь
//  пайплайн ничего не делает, пока его не выбрали. Запуск — иконка «Пайплайн…» в композере.
//  Каждый шаг — отдельный ход агента со своей ролью; провал шага помечает
//  следующие как «пропущен» (если у них нет continueOnFailure).
//  Полная спека: docs/vibe/manuals/pipelinesSpec.md.
// ─────────────────────────────────────────────────────────────────────────────
{
  "version": 1,
  "pipelines": [
    {
      "id": "feature",                    // обязателен, уникален; по нему запуск
      "name": "Фича под ключ",
      "description": "Спроектировать, реализовать, проверить",
      "steps": [                          // 1..20 шагов, порядок = порядок выполнения
        { "role": "planner",       "task": "Разбей задачу на шаги и запиши план в docs/plan.md" },
        // Потолки шага: превышение прекращает ШАГ (не прогон). Считаются по тому, что сообщает
        // агент: maxTokens — по занятому контексту, maxSteps — по вызовам инструментов.
        // 0 или отсутствие поля значат «потолка нет».
        { "role": "backend-dev",   "task": "Реализуй по плану", "acceptance": "Проект собирается",
          "maxTokens": 120000, "maxSteps": 40 },
        { "role": "code-reviewer", "task": "Найди дефекты в изменениях", "ignorePreviousArtifacts": true },
        // Знание переживает прогон: итог шага живёт до конца прогона и исчезает, а найденное по дороге
        // («как гонять тесты этого сервиса», грабля сборки) нужно следующему прогону. Шаг пишет ТОЛЬКО в
        // базу знаний — "paths" не пускает его в код, а нечего записать — пусть так и скажет.
        { "role": "implement-step", "task": "Если по дороге нашлось неочевидное (грабля, способ проверки, решение) — запиши в базу знаний проекта отдельной записью со строкой в её индексе. Нечего записать — так и скажи, не выдумывай",
          "paths": ["docs/knowledge/**", "docs/*/knowledge/**"], "continueOnFailure": true }
      ]
    },

    // ─── Роли, разведённые по каталогам ───────────────────────────────────────
    // "paths" и "denyPaths" — синтаксис .gitignore. Запреты проверяются ПЕРВЫМИ и сильнее
    // разрешений; порядок записей внутри списка ничего не меняет. Нет ни одного поля —
    // ограничения нет вовсе (шаг пишет куда угодно, как раньше).
    //   "tests/**"        — только дерево тестов
    //   "*.md"            — любой markdown на любом уровне (правило .gitignore для шаблона без /)
    //   "docs/"           — каталог целиком
    //   "**/secrets/**"   — типичный запрет
    // Права роли (ревьюер не пишет вовсе) действуют СВЕРХ этого: сузить можно, расширить нельзя.
    {
      "id": "feature-scoped",
      "name": "Фича с разделением по каталогам",
      "description": "Реализация, тесты и документация пишут каждый в своё",
      "steps": [
        { "role": "backend-dev", "task": "Реализуй возможность",
          "paths": ["src/**"], "denyPaths": ["**/secrets/**"] },
        { "role": "backend-dev", "task": "Покрой её тестами",
          "paths": ["tests/**", "**/testSrc/**"] },
        { "role": "backend-dev", "task": "Опиши её в документации",
          "paths": ["docs/**", "*.md"] },
        { "role": "code-reviewer", "task": "Проверь всё вместе", "ignorePreviousArtifacts": true }
      ]
    },

    // ─── Каскад: дешёвая модель, гейт, дорогая только если не приняли ──────────
    // Смысл каскада в том, что дорогой шаг выполняется НЕ ВСЕГДА. Решает это не модель
    // и не IDE, а ваш гейт — хук "pipelineStepEnd" в .vibe/hooks.json: код выхода 0 значит
    // «черновик принят» (шаги с "escalation": true пропускаются), код 2 — «не принят»
    // (они выполняются). Без такого хука принимать нечем, и эскалация идёт всегда.
    //
    // "model": "провайдер/модель" (одной строкой — так читают оба продукта; пара "provider" + "model" — устаревший синоним) уводит шаг с ACP-агента на прямой запрос к модели: у такого шага
    // НЕТ инструментов и НЕТ доступа к файлам, поэтому он разрешён только ролям, которые и так
    // ничего не пишут (explore, planner, code-reviewer, qa, security, critic).
    // Экономия считается просто: доля прогонов, где гейт принял, умноженная на разницу цен.
    // Не забудьте про повторную подачу контекста дорогому шагу — она тоже в счёте.
    {
      "id": "cascade-review",
      "name": "Каскад: дешёвый ревьюер, дорогой критик",
      "description": "Ревью дешёвой моделью; если гейт не принял — критик из другого семейства",
      "steps": [
        { "role": "code-reviewer", "model": "minimax/MiniMax-M3",
          "task": "Найди дефекты в изменениях последнего коммита. Кратко, по пунктам." },
        // Критик намеренно из ДРУГОГО семейства моделей: своей ошибки модель не видит по той же
        // причине, по которой её сделала. Это инженерная эвристика, а не доказанный факт.
        { "role": "critic", "model": "anthropic/claude-fable-5-1", "escalation": true,
          "task": "Черновик ревью выше неполон. Назови, что в нём пропущено и что неверно." }
      ]
    },
    {
      // Разделение по сложности без гейта: решения об устройстве — сильной модели, механические проверки —
      // дешёвой. В отличие от cascade-review дорогой шаг идёт всегда: он про архитектуру, а не про доработку
      // черновика. Модели заданы только ролям, которые ничего не пишут; реализует агент пайплайна.
      // Модели — пример: замените на те, к которым у вас есть ключи.
      "id": "split-by-difficulty",
      "name": "Сложное — сильной модели, механическое — дешёвой",
      "description": "План и критика устройства сильной моделью, реализация агентом, механическое ревью дешёвой моделью",
      "steps": [
        { "role": "planner", "model": "anthropic/claude-fable-5-1",
          "task": "Разбей задачу на шаги и назови решения об устройстве, которые придётся принять" },
        { "role": "backend-dev", "task": "Реализуй по плану" },
        { "role": "code-reviewer", "model": "minimax/MiniMax-M3",
          "task": "Механическая проверка изменений: стиль, соответствие плану, есть ли тесты. Кратко, по пунктам." },
        { "role": "critic", "model": "anthropic/claude-fable-5-1",
          "task": "Оцени устройство изменений: границы модулей, зависимости, что сломается при следующем шаге. Не стиль." }
      ]
    },
    {
      // Экран по брифу с приёмкой ПО БРИФУ, а не по рассказу исполнителя.
      // Смысл: требования и «типовые ловушки» разведены — первые проверяет приёмка, вторые заранее названы,
      // потому что на них генерация обычно и валится. Последний шаг получает бриф прогона дословно и НЕ получает
      // ни артефактов, ни резюме (поле "againstBrief"), поэтому судит по задаче, а не по пересказу.
      // Детектор дизайна (пол качества) — отдельный источник правды: зелёный детектор не означает «хорошо»,
      // он означает «пол не пробит».
      "id": "screen-from-brief",
      "name": "Экран по брифу с приёмкой по брифу",
      "description": "Собрать экран по описанию и проверить результат против исходной задачи, а не против собственного отчёта",
      "steps": [
        { "role": "planner",
          "task": "Разбери задачу на требования: перечисли их списком с номерами, каждое — цитатой из задачи. Отдельно назови типовые ловушки: состояния загрузки и ошибки, пустое состояние, длинный текст, узкий экран, возврат фокуса после закрытия окна. Ничего не реализуй." },
        { "role": "frontend-dev",
          "task": "Реализуй экран по плану. Каждое требование должно быть закрыто и названо в REQUIREMENTS отчёта шага.",
          "acceptance": "экран открывается, состояния загрузки, ошибки и пустоты существуют" },
        { "role": "qa",
          "task": "Прогони детектор дизайна (инструмент design_review, если он есть) в обоих вьюпортах и почини только то, что он нашёл в полу качества. Не трогай то, о чём он молчит." },
        { "role": "critic", "againstBrief": true,
          "task": "Перед тобой исходная задача целиком. Проверь по ней готовый экран: какие требования закрыты, какие нет, где сделано иначе, чем просили. Закончи вердиктом: отклонить, доработать или выпускать. Отдельно назови, чего ты проверить не смог." }
      ]
    },
    {
      // Анализ репозитория целиком на модели с большим окном. Модель — пример: Kimi K3, окно 1 048 576, цена не
      // зависит от длины контекста (platform.kimi.ai/docs/guide/kimi-k3-quickstart); замените на ту, к которой у вас
      // есть ключ. Продукты выполняют этот шаг по-разному, и результат осмысленный в обоих:
      //   • VibeIDEA: шаг с "model" — прямой запрос без инструментов, файлы в него кладёт "pack" (только файлы под git,
      //     без двоичных и без файлов с похожими на секреты строками). Пакет больше потолка (меньшее из maxTokens и
      //     окна модели) не обрезается — шаг не отправляется; оценка цены пишется до запроса.
      //   • VibeIDE: шаг с "model" — подагент с инструментами на этой модели, он читает файлы сам; "pack" там не
      //     читается и потолка пакета нет. Ограничить расход шага там можно его полем "maxTokens".
      // Спека VibeIDEA — docs/vibe/manuals/pipelinesSpec.md.
      "id": "repo-review",
      "name": "Обзор репозитория целиком",
      "description": "Устройство проекта по всем исходникам на модели с большим окном",
      "steps": [
        { "role": "explore", "model": "kimi/kimi-k3",
          "pack": { "paths": ["src/**", "*.md"], "exclude": ["**/*.lock", "**/generated/**"], "maxTokens": 600000 },
          "task": "Опиши устройство проекта: модули и границы между ними, зависимости, где что хранится, что выглядит заброшенным" }
      ]
    },

    // ─── Волна: независимые шаги одновременно ────────────────────────────────
    // Шаги, которые стоят подряд и несут одну метку "wave", VibeIDEA выполняет одновременно: каждый
    // в своей сессии агента и в своём блоке ленты, а следующий шаг получает резюме всех. Пишущим
    // шагам одной волны нужны "paths", начинающиеся с разных каталогов ("server/**" и "web/**"):
    // два шага, которым разрешён один файл, гонялись бы за ним, и такой пайплайн не загрузится.
    // Судящие роли (code-reviewer, security, critic, explore, planner) ничего не пишут — их можно
    // ставить рядом без "paths". В волне нельзя "escalation", "offPeak" и "context": "shared".
    //   • VibeIDE поле "wave" не читает и выполняет те же шаги по очереди — для независимых шагов
    //     это законный порядок, результат тот же.
    {
      "id": "review-wave",
      "name": "Ревью и безопасность разом",
      "description": "Два независимых взгляда на изменения одновременно, затем сводка",
      "steps": [
        { "role": "code-reviewer", "wave": "review",
          "task": "Найди дефекты в изменениях: логика, граничные случаи, обработка ошибок" },
        { "role": "security", "wave": "review",
          "task": "Найди уязвимости в изменениях: ввод извне, секреты, права, внешние вызовы" },
        { "role": "critic",
          "task": "Сведи замечания обоих: что чинить обязательно, что можно отложить, что лишнее" }
      ]
    }

    // ─── Дешёвый исполнитель: реализует дешёвая модель, сильная — только при провале ─
    // Образец закомментирован: модель по умолчанию — GPT-6 Luna (providers/openai.jsonc), а ключ OpenAI есть не у всех.
    // Luna — дешёвый тир GPT-6: вход $0,10, выход $0,50 за 1M против $4 / $20 у Opus 5.5, то есть в сорок раз дешевле
    // (страницы моделей вендоров, сверено 23.09.2026). Каскад окупается, пока эскалаций немного, — долю показывает
    // команда VibeIDE «Экономика каскада».
    // Гейт — исход шага ("acceptance"), а не мнение модели о себе.
    // ФОРМА ЗДЕСЬ — VibeIDE: модель на пишущем шаге и каскад полем "escalateTo". VibeIDEA такую форму не читает:
    // модель там разрешена только непишущим ролям, каскад — отдельным шагом с "escalation": true после гейта
    // (см. cascade-review выше); раскомментированный, этот пайплайн VibeIDEA пропустит с предупреждением.
    // Инструменты у GPT-6 работают только через Responses: шаг с моделью Luna в VibeIDE — подагент с
    // инструментами, поэтому провайдер должен ходить к ней через "protocol": "openai-responses".
    // Вместо адреса модели можно писать логическое имя "@cheap": в VibeIDE его задаёт настройка
    // vibeide.model.routes — блок "routes" из файлов провайдеров VibeIDE пока не читает.
    // {
    //   "id": "cheap-executor",
    //   "name": "Реализует дешёвая модель, при провале — сильная",
    //   "description": "План сильной моделью, реализация Luna с эскалацией на Opus 5.5, ревью",
    //   "steps": [
    //     { "role": "planner", "model": "anthropic/claude-opus-5-5",
    //       "task": "Разбей задачу на шаги, для каждого назови, как проверить, что он сделан" },
    //     { "role": "backend-dev", "model": "openai/gpt-6-luna", "escalateTo": "anthropic/claude-opus-5-5",
    //       "acceptance": "Проект собирается, тесты зелёные",
    //       "task": "Реализуй по плану" },
    //     { "role": "code-reviewer", "ignorePreviousArtifacts": true,
    //       "task": "Найди дефекты в изменениях: логика, граничные случаи, обработка ошибок" }
    //   ]
    // }
  ]
}
