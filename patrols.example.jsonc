// ─────────────────────────────────────────────────────────────────────────────
//  .vibe/patrols.json — дежурные проверки проекта
//
//  Это ПРИМЕР. Чтобы включить: скопируйте в .vibe/patrols.json (строгий JSON, без
//  комментариев) и оставьте нужные записи.
//
//  Смысл: любой ход агента начинается с модели, то есть с денег. Дежурная проверка
//  переворачивает порядок — по расписанию выполняется дешёвая команда проекта, и
//  модель зовётся, только если команда нашла повод.
//
//  Код возврата пробы решает всё: 0 — делать нечего, ненулевой — есть повод
//  (то же правило, что у skipIf в servers.json). Модель сама не зовётся: приходит
//  уведомление с кнопкой «Отдать агенту».
//
//  Полная спека: docs/vibe/manuals/patrolsSpec.md
// ─────────────────────────────────────────────────────────────────────────────
{
  "version": 1,
  "patrols": [
    // Свежие TODO в коде: проба возвращает ненулевой код, когда они есть.
    { "id": "todo", "label": "Незакрытые TODO", "probe": "! grep -rq TODO src",
      "everyMinutes": 60, "maxPerDay": 3,
      "prompt": "Найди свежие TODO в src и предложи, что из них стоит закрыть сейчас" },

    // Упавший прогон CI. Требует gh и входа в него; выключено по умолчанию.
    { "id": "ci", "active": false, "probe": "gh run list --limit 5 --json conclusion | grep -q failure",
      "everyMinutes": 15, "prompt": "Посмотри последний упавший прогон CI и назови причину" },

    // Отставание от upstream. Проба ничего не качает — смотрит уже известное состояние.
    { "id": "behind", "active": false, "probe": "test \"$(git rev-list --count HEAD..@{u} 2>/dev/null || echo 0)\" -gt 0",
      "everyMinutes": 240, "maxPerDay": 2 }
  ]
}
