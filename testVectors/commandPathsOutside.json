[
	{
		"name": "инцидент: --save /VolumES при том же томе в другом регистре",
		"command": "npm run compare:brandbook -- --save /VolumES",
		"roots": [
			"/Users/a/proj"
		],
		"caseInsensitive": true,
		"expected": [
			{
				"path": "/VolumES",
				"critical": true,
				"readOnly": false
			}
		]
	},
	{
		"name": "значение длинной опции --save=/path",
		"command": "npm run compare:brandbook --save=/Volumes/ExVint/work",
		"roots": [
			"/Users/a/proj"
		],
		"caseInsensitive": true,
		"expected": [
			{
				"path": "/Volumes/ExVint/work",
				"critical": false,
				"readOnly": false
			}
		]
	},
	{
		"name": "значение короткой опции приклеено к ней: -o/path",
		"command": "tool -o/Volumes/ExVint/work",
		"roots": [
			"/Users/a/proj"
		],
		"caseInsensitive": true,
		"expected": [
			{
				"path": "/Volumes/ExVint/work",
				"critical": false,
				"readOnly": false
			}
		]
	},
	{
		"name": "путь в проекте остаётся своим",
		"command": "cat /Users/a/proj/src/a.ts",
		"roots": [
			"/Users/a/proj"
		],
		"caseInsensitive": true,
		"expected": []
	},
	{
		"name": "временный каталог остаётся своим",
		"command": "cp a /tmp/x",
		"roots": [
			"/Users/a/proj"
		],
		"caseInsensitive": true,
		"expected": []
	},
	{
		"name": "служебное устройство не является путём данных",
		"command": "cat /dev/null",
		"roots": [
			"/Users/a/proj"
		],
		"caseInsensitive": true,
		"expected": []
	},
	{
		"name": "URL не является путём",
		"command": "curl https://x.y/z",
		"roots": [
			"/Users/a/proj"
		],
		"caseInsensitive": true,
		"expected": []
	},
	{
		"name": "регистр без учёта (macOS): путь в проекте",
		"command": "ls /USERS/A/PROJ/src",
		"roots": [
			"/Users/a/proj"
		],
		"caseInsensitive": true,
		"expected": []
	},
	{
		"name": "регистр с учётом (Linux): тот же путь уже внешний",
		"command": "ls /USERS/A/PROJ/src",
		"roots": [
			"/Users/a/proj"
		],
		"caseInsensitive": false,
		"expected": [
			{
				"path": "/USERS/A/PROJ/src",
				"critical": false,
				"readOnly": true
			}
		]
	},
	{
		"name": "домашний каталог всегда вне проекта и критичен",
		"command": "rm -rf ~",
		"roots": [
			"/Users/a/proj"
		],
		"caseInsensitive": true,
		"expected": [
			{
				"path": "~",
				"critical": true,
				"readOnly": false
			}
		]
	},
	{
		"name": "вложенный путь в $HOME без известной домашней папки — внешний, но не корень",
		"command": "cp a $HOME/x",
		"roots": [
			"/Users/a/proj"
		],
		"caseInsensitive": true,
		"expected": [
			{
				"path": "$HOME/x",
				"critical": false,
				"readOnly": false
			}
		]
	},
	{
		"name": "буква диска: путь в проекте",
		"command": "dir C:\\Users\\a\\proj\\x",
		"roots": [
			"C:\\Users\\a\\proj"
		],
		"caseInsensitive": true,
		"expected": []
	},
	{
		"name": "буква диска: корень диска критичен",
		"command": "dir D:\\",
		"roots": [
			"C:\\Users\\a\\proj"
		],
		"caseInsensitive": true,
		"expected": [
			{
				"path": "D:\\",
				"critical": true,
				"readOnly": false
			}
		]
	},
	{
		"name": "относительный выход вверх внешний, но не критичный",
		"command": "cp a ../other/file",
		"roots": [
			"/Users/a/proj"
		],
		"caseInsensitive": true,
		"expected": [
			{
				"path": "../other/file",
				"critical": false,
				"readOnly": false
			}
		]
	},
	{
		"name": "чтение системного файла тоже вне проекта",
		"command": "cat /etc/hosts",
		"roots": [
			"/Users/a/proj"
		],
		"caseInsensitive": true,
		"expected": [
			{
				"path": "/etc/hosts",
				"critical": false,
				"readOnly": true
			}
		]
	},
	{
		"name": "корень файловой системы критичен",
		"command": "rm -rf /",
		"roots": [
			"/Users/a/proj"
		],
		"caseInsensitive": true,
		"expected": [
			{
				"path": "/",
				"critical": true,
				"readOnly": false
			}
		]
	},
	{
		"name": "корень тома критичен",
		"command": "rm -rf /Volumes",
		"roots": [
			"/Users/a/proj"
		],
		"caseInsensitive": true,
		"expected": [
			{
				"path": "/Volumes",
				"critical": true,
				"readOnly": false
			}
		]
	},
	{
		"name": "том целиком критичен",
		"command": "rm -rf /Volumes/Ext",
		"roots": [
			"/Users/a/proj"
		],
		"caseInsensitive": true,
		"expected": [
			{
				"path": "/Volumes/Ext",
				"critical": true,
				"readOnly": false
			}
		]
	},
	{
		"name": "съёмный носитель Linux критичен",
		"command": "rm -rf /media/me/disk",
		"roots": [
			"/Users/a/proj"
		],
		"caseInsensitive": true,
		"expected": [
			{
				"path": "/media/me/disk",
				"critical": true,
				"readOnly": false
			}
		]
	},
	{
		"name": "системный каталог критичен сам",
		"command": "rm -rf /System",
		"roots": [
			"/Users/a/proj"
		],
		"caseInsensitive": true,
		"expected": [
			{
				"path": "/System",
				"critical": true,
				"readOnly": false
			}
		]
	},
	{
		"name": "вложенный путь системного каталога уже не критичен",
		"command": "rm -rf /usr/local/bin",
		"roots": [
			"/Users/a/proj"
		],
		"caseInsensitive": true,
		"expected": [
			{
				"path": "/usr/local/bin",
				"critical": false,
				"readOnly": false
			}
		]
	},
	{
		"name": "дубли путей убираются, порядок остаётся как в команде",
		"command": "cp /Volumes/x /tmp/y --save=/Volumes/x ../z ../z",
		"roots": [
			"/Users/a/proj"
		],
		"caseInsensitive": true,
		"expected": [
			{
				"path": "/Volumes/x",
				"critical": true,
				"readOnly": false
			},
			{
				"path": "../z",
				"critical": false,
				"readOnly": false
			}
		]
	},
	{
		"name": "несколько путей: описание перечисляет каждый",
		"command": "npm run x -- --save /VolumES ../other",
		"roots": [
			"/Users/a/proj"
		],
		"caseInsensitive": true,
		"expected": [
			{
				"path": "/VolumES",
				"critical": true,
				"readOnly": false
			},
			{
				"path": "../other",
				"critical": false,
				"readOnly": false
			}
		]
	},
	{
		"name": "безобидная цепочка: -la и перенаправление в /dev/null",
		"command": "ls -la && npm test 2>/dev/null",
		"roots": [
			"/Users/a/proj"
		],
		"caseInsensitive": true,
		"expected": []
	},
	{
		"name": "путь проекта в опции -C своего не делает",
		"command": "git -C /Users/a/proj status",
		"roots": [
			"/Users/a/proj"
		],
		"caseInsensitive": true,
		"expected": []
	},
	{
		"name": "с известной домашней папкой сам ~ — корень",
		"command": "rm -rf ~",
		"roots": [
			"/Users/a/proj"
		],
		"caseInsensitive": true,
		"home": "/Users/a",
		"expected": [
			{
				"path": "~",
				"critical": true,
				"readOnly": false
			}
		]
	},
	{
		"name": "с известной домашней папкой ~/x — внешний, не корень",
		"command": "rm -rf ~/x",
		"roots": [
			"/Users/a/proj"
		],
		"caseInsensitive": true,
		"home": "/Users/a",
		"expected": [
			{
				"path": "~/x",
				"critical": false,
				"readOnly": false
			}
		]
	},
	{
		"name": "каталог в домашней папке, разрешённый корнем, свой",
		"command": "ls ~/.vibememory/store",
		"roots": [
			"/Users/a/proj",
			"/Users/a/.vibememory"
		],
		"caseInsensitive": true,
		"home": "/Users/a",
		"expected": []
	},
	{
		"name": "шаблон grep с обратной косой — не путь",
		"command": "grep -rn -e a engine | grep -v \"\\.venv\\|test\"",
		"roots": [
			"/Users/a/proj"
		],
		"caseInsensitive": true,
		"expected": []
	},
	{
		"name": "шаблон grep с экранированными скобками — не путь",
		"command": "sed -n 1,9p R.md | grep -n \"\\[ \\]\\|⚠\"",
		"roots": [
			"/Users/a/proj"
		],
		"caseInsensitive": true,
		"expected": []
	},
	{
		"name": "экранирование в тексте printf — не путь",
		"command": "printf '\\n## Ночной режим\\n' >> docs/decisions.md",
		"roots": [
			"/Users/a/proj"
		],
		"caseInsensitive": true,
		"expected": []
	},
	{
		"name": "чтение корня тома — путь только для чтения",
		"command": "ls /Volumes",
		"roots": [
			"/Users/a/proj"
		],
		"caseInsensitive": true,
		"expected": [
			{
				"path": "/Volumes",
				"critical": true,
				"readOnly": true
			}
		]
	},
	{
		"name": "перенаправление вывода наружу — запись",
		"command": "cat a > /Volumes/Ext/x",
		"roots": [
			"/Users/a/proj"
		],
		"caseInsensitive": true,
		"expected": [
			{
				"path": "/Volumes/Ext/x",
				"critical": false,
				"readOnly": false
			}
		]
	},
	{
		"name": "приклеенное перенаправление 2>/путь — запись",
		"command": "ls 2>/Volumes/Ext/log",
		"roots": [
			"/Users/a/proj"
		],
		"caseInsensitive": true,
		"expected": [
			{
				"path": "/Volumes/Ext/log",
				"critical": false,
				"readOnly": false
			}
		]
	},
	{
		"name": "find с -delete — запись",
		"command": "find /Volumes/Ext -name x -delete",
		"roots": [
			"/Users/a/proj"
		],
		"caseInsensitive": true,
		"expected": [
			{
				"path": "/Volumes/Ext",
				"critical": true,
				"readOnly": false
			}
		]
	},
	{
		"name": "путь Windows с обратной косой в кавычках — путь",
		"command": "dir \"C:\\Program Files\\x\"",
		"roots": [
			"/Users/a/proj"
		],
		"caseInsensitive": true,
		"expected": [
			{
				"path": "C:\\Program Files\\x",
				"critical": false,
				"readOnly": false
			}
		]
	},
	{
		"name": "cd в соседний каталог — только смена каталога",
		"command": "cd /p/front && cd ../back && git fetch",
		"roots": [
			"/p/front"
		],
		"caseInsensitive": true,
		"expected": [
			{
				"path": "../back",
				"critical": false,
				"readOnly": true
			}
		],
		"cwd": "/p/front"
	},
	{
		"name": "cd .. из подкаталога остаётся в проекте",
		"command": "cd /p/wt; cd server && bun test; cd .. && bun test tools",
		"roots": [
			"/p"
		],
		"caseInsensitive": true,
		"expected": [],
		"cwd": "/p"
	},
	{
		"name": ".. от известного каталога внутри проекта — свой",
		"command": "cp a ../b",
		"roots": [
			"/p"
		],
		"caseInsensitive": true,
		"expected": [],
		"cwd": "/p/src"
	},
	{
		"name": ".. от корня проекта наружу — запись вне",
		"command": "cp a ../b",
		"roots": [
			"/p"
		],
		"caseInsensitive": true,
		"expected": [
			{
				"path": "../b",
				"critical": false,
				"readOnly": false
			}
		],
		"cwd": "/p"
	},
	{
		"name": "после неясного cd каталог неизвестен — .. внешний",
		"command": "cd $X && cp a ../b",
		"roots": [
			"/p"
		],
		"caseInsensitive": true,
		"expected": [
			{
				"path": "../b",
				"critical": false,
				"readOnly": false
			}
		],
		"cwd": "/p/src"
	}
]
