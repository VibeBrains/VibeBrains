{
  "_comment": "Общие тестовые векторы файла MCP-серверов семейства — ~/.vibe/mcp.json (общий) и <проект>/.vibe/mcp.json (проекта). Читают тесты VibeIDE и VibeIDEA: один и тот же файл обязан давать в обоих продуктах одни и те же серверы и одни и те же жалобы. Не сид — в products.json адресован пустому списку продуктов. Файл: lines — строки, склеенные через \\n. Вид сервера в expect: stdio — запись с command, в нормальной форме (command без пробелов по краям, args и env строками, по умолчанию [] и {}, disabled — булево: true и строка «true» выключают, всё прочее нет); remote — имена записей с url без command: их держит продукт, умеющий адреса (VibeIDE), остальные пропускают МОЛЧА, это не жалоба. Жалобы — {problem, name?}: NOT_JSON (не разобрался или корень не объект), NO_SECTION (нет объекта mcpServers), NOT_AN_OBJECT (запись не объект), NO_COMMAND (нет ни command, ни url), AMBIGUOUS (есть и command, и url — запись пропускается). Битая запись называется и пропускается, остальные работают. Слои: общий файл слабее файла проекта; запись проекта заменяет запись общего файла целиком, не по полям; имена сравниваются точно; битый файл одного слоя не отключает другой. sourceOfName — слой, чья запись действует. Поля cwd, tools, headers и прочие формата VibeIDE разбору stdio-вида не мешают и в вектор не входят. Собрано 15.10.2026 по McpServersFile.kt и McpServersFileTest.kt VibeIDEA и mcpServersFile.ts VibeIDE.",
  "version": 1,
  "parse": [
    {"name": "обычная форма: как её пишут другие инструменты, выключенный строкой «true»", "lines": ["{", "  \"mcpServers\": {", "    \"github\": {", "      \"command\": \"npx\",", "      \"args\": [", "        \"-y\",", "        \"@modelcontextprotocol/server-github\"", "      ],", "      \"env\": {", "        \"GITHUB_TOKEN\": \"x\"", "      }", "    },", "    \"старый\": {", "      \"command\": \"node\",", "      \"args\": [", "        \"server.js\"", "      ],", "      \"disabled\": \"true\"", "    }", "  }", "}"], "expect": {"stdio": {"github": {"command": "npx", "args": ["-y", "@modelcontextprotocol/server-github"], "env": {"GITHUB_TOKEN": "x"}, "disabled": false}, "старый": {"command": "node", "args": ["server.js"], "env": {}, "disabled": true}}, "remote": [], "problems": []}},
    {"name": "выключатель: булево true выключает, false и любое другое слово — нет", "lines": ["{", "  \"mcpServers\": {", "    \"a\": {", "      \"command\": \"node\",", "      \"disabled\": true", "    },", "    \"b\": {", "      \"command\": \"node\",", "      \"disabled\": false", "    },", "    \"c\": {", "      \"command\": \"node\",", "      \"disabled\": \"yes\"", "    },", "    \"d\": {", "      \"command\": \"node\"", "    }", "  }", "}"], "expect": {"stdio": {"a": {"command": "node", "args": [], "env": {}, "disabled": true}, "b": {"command": "node", "args": [], "env": {}, "disabled": false}, "c": {"command": "node", "args": [], "env": {}, "disabled": false}, "d": {"command": "node", "args": [], "env": {}, "disabled": false}}, "remote": [], "problems": []}},
    {"name": "запись без запуска названа по имени, остальные работают", "lines": ["{", "  \"mcpServers\": {", "    \"пустой\": {},", "    \"рабочий\": {", "      \"command\": \"node\"", "    }", "  }", "}"], "expect": {"stdio": {"рабочий": {"command": "node", "args": [], "env": {}, "disabled": false}}, "remote": [], "problems": [{"problem": "NO_COMMAND", "name": "пустой"}]}},
    {"name": "пустая или из пробелов команда — тоже без запуска", "lines": ["{", "  \"mcpServers\": {", "    \"x\": {", "      \"command\": \"   \"", "    }", "  }", "}"], "expect": {"stdio": {}, "remote": [], "problems": [{"problem": "NO_COMMAND", "name": "x"}]}},
    {"name": "запись не объект — названа, остальные работают", "lines": ["{", "  \"mcpServers\": {", "    \"x\": \"node\",", "    \"y\": {", "      \"command\": \"node\"", "    }", "  }", "}"], "expect": {"stdio": {"y": {"command": "node", "args": [], "env": {}, "disabled": false}}, "remote": [], "problems": [{"problem": "NOT_AN_OBJECT", "name": "x"}]}},
    {"name": "запись по адресу — удалённый сервер: его держит продукт, умеющий адреса, остальные пропускают молча", "lines": ["{", "  \"mcpServers\": {", "    \"tracker\": {", "      \"url\": \"https://mcp.tracker.example/mcp\",", "      \"type\": \"http\"", "    },", "    \"local\": {", "      \"command\": \"node\"", "    }", "  }", "}"], "expect": {"stdio": {"local": {"command": "node", "args": [], "env": {}, "disabled": false}}, "remote": ["tracker"], "problems": []}},
    {"name": "и command, и url в одной записи — двусмысленность: два продукта запустили бы разное, запись пропускается", "lines": ["{", "  \"mcpServers\": {", "    \"both\": {", "      \"command\": \"node\",", "      \"url\": \"https://mcp.example.com/mcp\"", "    },", "    \"ok\": {", "      \"command\": \"node\"", "    }", "  }", "}"], "expect": {"stdio": {"ok": {"command": "node", "args": [], "env": {}, "disabled": false}}, "remote": [], "problems": [{"problem": "AMBIGUOUS", "name": "both"}]}},
