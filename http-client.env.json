// ─────────────────────────────────────────────────────────────────────────────
//  http-client.env.json — окружения для файлов .http (VibeIDEA)
//
//  Это РАБОЧИЙ файл: окружения для .http, лежащих РЯДОМ с ним. Держите запросы и их
//  окружения в одной папке — искать переменные IDE будет там же. Комментарии писать МОЖНО.
//  Окружение выбирается в панели «HTTP».
//
//  ЭТОТ файл едет в git — в нём только адреса и другие несекретные значения.
//  Секреты кладутся в http-client.private.env.json рядом (он в .gitignore):
//  приватный файл перекрывает общий по ключу, потому что в нём лежит настоящий токен.
//
//  Полная спека: docs/vibe/manuals/httpClientSpec.md
// ─────────────────────────────────────────────────────────────────────────────
{
  "local": {
    "host": "http://localhost:8080",
    "token": "локальный-токен-не-секрет"
  },
  "staging": {
    "host": "https://staging.example.com"
    // токен для staging — в http-client.private.env.json
  },
  "prod": {
    "host": "https://api.example.com"
  }
}
