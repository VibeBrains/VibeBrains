        "\\bdoesn['’]?t\\s+mean\\s+[^.?!;]{1,60}[,.]\\s*(?:it|but)\\b",
        "^\\s*(?:it|that|this)\\s+(?:is|was)\\s+not\\s+[^.?!;]{1,60}[.]\\s*(?:it|that|this)\\s+(?:is|was)\\b"
      ]
    },
    {
      "id": "EN-S2",
      "lang": "en",
      "kind": "regex",
      "severity": "major",
