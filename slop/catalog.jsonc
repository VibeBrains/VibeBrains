    {
      "id": "EN-S13",
      "lang": "en",
      "kind": "regex",
      "severity": "major",
      "name": "Summary-recap ending",
      "fix": "The reader was just there. End on the last concrete point, takeaway, or next action.",
      "patterns": [
        "^[ \\t]*(?:in\\s+conclusion|to\\s+conclude|in\\s+summary|to\\s+summarize|to\\s+sum\\s+up|all\\s+in\\s+all|wrapping\\s+up|to\\s+wrap\\s+up)\\b",
