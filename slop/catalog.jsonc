      "patterns": [
        "\\b(?:the\\s+)?(?:best|worst|hard|real|tricky|catch|kicker|problem|twist|trick|detail|result|upshot|takeaway)\\s*(?:part|thing|bit)?\\s*:(?=\\s+[a-z])"
