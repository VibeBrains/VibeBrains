// ─────────────────────────────────────────────────────────────────────────────
//  slop/catalog.jsonc — каталог примет машинного письма («нейрослопа») для детектора текста.
//
//  СЛУЖЕБНЫЙ файл набора: продукты читают его ИЗ СБОРКИ, в проекты он не засевается
//  (products.json адресует его никому). Засеянная копия заморозила бы сегодняшние списки
//  так же, как засеянный файл базового языка замораживает сегодняшние формулировки: исправленное
//  здесь осталось бы перекрыто старой копией. Правки проекта — в .vibe/slop.json.
//  Спека формата и правок: docs/vibe/manuals/slopSpec.md в репозитории VibeIDEA.
//
//  КАК УСТРОЕНО:
//   • Каждое правило: id, язык (ru / en / any), вид, вес, имя и подсказка «как исправить».
//   • Язык решает, какие абзацы правило читает: русский список нечего искать в английском
//     абзаце, а длинное тире — примета в английской прозе и обычная грамматика в русской.
//   • Виды: words и phrases — списки (звёздочка в конце слова — любое окончание, «ё» ловит
//     и «е»); opener — слова в НАЧАЛЕ предложения; regex — шаблоны Java-регулярок;
//     density — приём, который обычен один раз и становится привычкой в третий;
//     invisible, rhythm-*, decorative-bold, heading-stub, title-case — проверки, чья логика
//     живёт в коде, а здесь у них только имя, вес и подсказка.
//   • Веса: note — пометка, minor — привычка, major — шаблон или выдумка. Текст проходит
//     при счёте от passScore и без находок тяжелее maxSeverity.
//   • Добавили правило — прогоните тесты: образец чистого русского и английского текста
//     обязан набирать не меньше 95, иначе правило ловит обычный язык.
//
//  Английская часть (правила EN-*) — списки и шаблоны misbahsy/anti-ai-slop, rules.json
//  (github.com/misbahsy/anti-ai-slop, коммит 1b7d68f2de11). Правила русской части (RU-*)
//  и общие правила написаны для этого набора. Лицензия английской части:
//
//    MIT License
//
//    Copyright (c) 2026 anti-ai-slop contributors
//
//    Permission is hereby granted, free of charge, to any person obtaining a copy
//    of this software and associated documentation files (the "Software"), to deal
//    in the Software without restriction, including without limitation the rights
//    to use, copy, modify, merge, publish, distribute, sublicense, and/or sell
//    copies of the Software, and to permit persons to whom the Software is
//    furnished to do so, subject to the following conditions:
//
//    The above copyright notice and this permission notice shall be included in all
//    copies or substantial portions of the Software.
//
//    THE SOFTWARE IS PROVIDED "AS IS", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR
//    IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,
//    FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE
//    AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER
//    LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM,
//    OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE
//    SOFTWARE.
// ─────────────────────────────────────────────────────────────────────────────
{
  "version": 1,
  "scoring": {"start": 100, "floor": 0, "severityPoints": {"blocker": 30, "major": 15, "minor": 5, "note": 1}, "repeatPoints": {"blocker": 10, "major": 5, "minor": 2, "note": 0.5}, "ruleCapMultiplier": 3, "passScore": 90, "maxSeverity": "minor"},
  "rules": [
    // Ищется в сыром тексте, даже внутри кода: пробел нулевой ширины в сниппете сломает того, кто его
    // скопирует.
    {
      "id": "U1",
      "lang": "any",
      "kind": "invisible",
      "severity": "major",
      "name": "Невидимый символ",
      "fix": "Удалите: такие символы не видны ни автору, ни ревьюеру, а ломают поиск, дифф и копирование."
    },
    // Эмодзи в заголовке и в начале пункта выдаёт шаблон на любом языке, поэтому правило одно на оба.
    // У источника есть английская копия (F2 в его rules.json); здесь она влита сюда, чтобы выключенное
    // в проекте «F2» не всплывало под вторым id.
    {
      "id": "F2",
      "lang": "any",
      "kind": "regex",
      "severity": "minor",
      "name": "Эмодзи вместо структуры",
      "fix": "Уберите. Форма должна следовать содержанию, а не украшать его.",
      "patterns": [
        "^\\s{0,3}#{1,6}\\s+.*[✨🚀🔥💡🎯📊✅⭐🌟👇🔑⚡🧠🎉📈🛠🧵📌👉❗📝💪🙌🏆]",
        "^[ \\t]*[-*+]\\s+[✨🚀🔥💡🎯📊✅⭐🌟⚡🧠🎉📈👉❗📝💪🙌🏆]"
      ]
    },
    {
      "id": "F5",
      "lang": "any",
      "kind": "decorative-bold",
      "severity": "note",
      "name": "Жирный посреди фразы",
      "fix": "Жирный в середине предложения — украшение. Уберите его или пусть фраза несёт акцент сама."
    },
    {
      "id": "F6",
      "lang": "any",
      "kind": "heading-stub",
      "severity": "note",
      "name": "Заголовок над одной-двумя фразами",
      "fix": "Заголовок над парой предложений — строительные леса. Влейте раздел в текст."
    },
    {
      "id": "F7",
      "lang": "any",
      "kind": "title-case",
      "severity": "note",
      "name": "Каждое Слово С Заглавной",
      "fix": "В заголовке заглавная только у первого слова и у имён собственных."
    },
    {
      "id": "R1",
      "lang": "any",
      "kind": "rhythm-uniform",
      "severity": "note",
      "name": "Метроном: предложения одной длины",
      "fix": "Четыре предложения подряд почти одной длины. Разбейте одно или соедините два."
    },
    {
      "id": "R2",
      "lang": "any",
      "kind": "rhythm-fragments",
      "severity": "minor",
      "name": "Рубленые фразы подряд",
      "fix": "Четыре коротких предложения подряд — изготовленный ритм. Соедините часть."
    },
    {
      "id": "D2",
      "lang": "any",
      "kind": "density",
      "severity": "minor",
      "name": "Много риторических вопросов",
      "fix": "Вопросы, на которые текст сам же отвечает. Большинство превратите в утверждения.",
      "caseSensitive": true,
      "minCount": 3,
      "thresholdPer1000": 8.0,
      "patterns": [
        "[^.!?\\n]{8,120}\\?(?=\\s+\\p{Lu})"
      ]
    },

    // ─── Русский ───
    // Слова, которые модели ставят вместо конкретного. Основа со звёздочкой — любое окончание.
    {
      "id": "RU-W1",
      "lang": "ru",
      "kind": "words",
      "severity": "minor",
      "name": "Слова-штампы",
      "fix": "Назовите то конкретное, что это слово заменяет. Если за ним ничего нет — вычеркните предложение.",
      "items": [
        "бесшовн*", "синерги*", "синергетическ*", "холистическ*", "инновационн*", "революционн*", "революционизир*",
        "непревзойдённ*", "беспрецедентн*", "многогранн*", "всеобъемлющ*", "первоклассн*", "прорывн*", "новаторск*",
        "ультрасовременн*", "краеугольн*", "неотъемлем*", "виртуозн*", "филигранн*", "непоколебим*", "неустанн*",
        "впечатляющ*", "захватывающ*", "бесценн*", "примечательн*", "знаменательн*", "эпохальн*", "потрясающ*",
        "поистине", "воистину", "геймчейнджер*", "мастхэв*", "маст-хэв*", "вау-эффект*", "дисрапт*"
      ]
    },
    // Целые обороты без сведений. Тяжелее слова: оборот ставят нарочно, слово — бывает, случайно.
    {
      "id": "RU-W2",
      "lang": "ru",
      "kind": "phrases",
      "severity": "major",
      "name": "Пустые фразы",
      "fix": "Удалите. Если предложение умирает без этой фразы — оно и было этой фразой.",
      "items": [
        "в современном мире", "в современном быстро меняющемся мире", "в быстро меняющемся мире",
        "в стремительно меняющемся мире", "в наше время", "в наши дни", "в эпоху цифров*",
        "в эпоху искусственного интеллекта", "в эпоху ИИ", "в цифровую эпоху", "в мире, где", "в мире технологий",
        "в мире разработки", "в мире IT", "в мире ИИ", "как никогда ранее", "как никогда актуальн*",
        "стоит отметить", "стоит подчеркнуть", "стоит упомянуть", "важно отметить", "важно подчеркнуть",
        "важно понимать", "важно помнить", "следует отметить", "следует подчеркнуть", "нельзя не отметить",
        "нельзя не упомянуть", "не секрет, что", "ни для кого не секрет", "общеизвестно, что",
        "открыва* новые возможности", "открыва* новые горизонты", "открыва* двери", "раскры* потенциал",
        "раскры* весь потенциал", "раскры* свой потенциал", "раскрытие потенциала", "на новый уровень",
        "меня* правила игры", "смена парадигмы", "новая парадигма", "цифровая трансформация", "комплексный подход",
        "с каждым днём всё", "день ото дня", "разложим по полочкам", "разберём по полочкам", "по полочкам",
        "без лишних слов", "без лишней воды", "в рамках данной статьи", "в данной статье", "в этой статье мы",
        "в этом материале мы", "по большому счёту", "золотая середина", "палка о двух концах", "верхушка айсберга",
        "кладезь", "безграничные возможности", "бесконечные возможности", "возможности безграничны", "время покажет",
        "идти в ногу со временем", "держать руку на пульсе", "широк* спектр*", "уникальн* возможност*",
        "ключ к успеху", "секрет успеха", "залог успеха", "вызовы и возможности", "новые вызовы",
        "ответить на вызовы", "отвечать на вызовы", "задачи любой сложности", "всё в одном месте", "лучш* в мире"
      ]
    },
    // Связка, за которой тянутся, когда связывать нечего. Считается только в начале предложения.
    {
      "id": "RU-W3",
      "lang": "ru",
      "kind": "opener",
      "severity": "minor",
      "name": "Шаблонное начало фразы",
      "fix": "Начните с факта, числа или утверждения.",
      "items": [
        "Итак", "Более того", "Кроме того", "Помимо этого", "Помимо того", "К тому же", "Таким образом",
        "Следовательно", "Безусловно", "Несомненно", "Разумеется", "Бесспорно", "Очевидно", "В целом",
        "В конечном итоге", "В конечном счёте", "По сути", "По сути дела", "По большому счёту", "Интересно",
        "Примечательно", "Любопытно", "Как ни странно", "Что ещё важнее", "Что важнее", "Короче говоря",
        "Иными словами", "Другими словами", "Проще говоря", "Одним словом", "В итоге", "Подытоживая", "Резюмируя",
        "Подводя итог", "В заключение", "Стоит ли говорить", "Надо сказать", "Нужно сказать"
      ]
    },
    // Остаток окна чата в тексте, который читает не собеседник.
    {
      "id": "RU-W4",
      "lang": "ru",
      "kind": "phrases",
      "severity": "major",
      "name": "Голос ассистента",
      "fix": "Остаток окна чата. В опубликованном тексте нет собеседника, с которым надо быть вежливым. Удалите.",
      "items": [
        "отличный вопрос", "хороший вопрос", "прекрасный вопрос", "замечательный вопрос", "спасибо за вопрос",
        "спасибо за ваш вопрос", "надеюсь, это поможет", "надеюсь, это помогло", "надеюсь, это было полезно",
        "надеюсь, это было полезным", "надеюсь, вам было полезно", "надеюсь, вам понравится",
        "надеюсь, вам понравилось", "если у вас остались вопросы", "если у вас есть вопросы",
        "если остались вопросы", "если возникнут вопросы", "не стесняйтесь", "не стесняйся", "обращайтесь, если",
        "буду рад помочь", "буду рада помочь", "буду рад ответить", "рад помочь", "рада помочь",
        "с удовольствием помогу", "с радостью помогу", "дайте знать, если", "дай знать, если", "дайте мне знать",
        "как ИИ, я", "как языковая модель", "как ИИ-ассистент", "я — языковая модель", "будучи ИИ",
        "будучи языковой моделью", "рад сообщить", "рады сообщить", "рады представить", "рады анонсировать",
        "с радостью сообщаем", "с гордостью представляем", "вы абсолютно правы", "вы совершенно правы",
        "приношу извинения за путаницу", "извините за путаницу", "прошу прощения за путаницу", "вот что я нашёл",
        "вот что мне удалось найти", "конечно! вот", "я подготовил для вас", "я подготовила для вас"
      ]
    },
    // Решает контекст, поэтому только пометка: иногда слово несёт настоящий контраст или неуверенность.
    {
      "id": "RU-W5",
      "lang": "ru",
      "kind": "words",
      "severity": "note",
      "name": "Слова-пустышки",
      "fix": "Вычеркните, если ничего не добавляет. Оставьте, только если несёт настоящий контраст или неуверенность.",
      "items": [
        "очень", "действительно", "по-настоящему", "буквально", "абсолютно", "совершенно", "крайне", "чрезвычайно",
        "максимально", "невероятно", "безумно", "реально", "просто", "фактически", "собственно", "в принципе",
        "по сути", "на самом деле", "вообще-то", "в общем-то", "как бы"
      ]
    },
    // Самая короткая дорога к выдумке: следующий шаг после «исследования показывают» — придуманная ссылка.
    {
      "id": "RU-W6",
      "lang": "ru",
      "kind": "phrases",
      "severity": "major",
      "name": "Безымянный авторитет",
      "fix": "Назовите источник или вычеркните утверждение. Не придумывайте ссылку.",
      "items": [
        "исследования показывают", "исследования показали", "исследования доказывают", "исследования доказали",
        "как показывают исследования", "согласно исследованиям", "учёные доказали", "учёные выяснили",
        "учёные установили", "эксперты сходятся", "эксперты считают", "эксперты утверждают", "эксперты отмечают",
        "по мнению экспертов", "по оценкам экспертов", "специалисты считают", "по мнению специалистов",
        "как показывает практика", "как показывает опыт", "статистика показывает", "статистика говорит",
        "данные показывают", "опросы показывают", "многие считают", "многие уверены", "принято считать",
        "общепризнанно"
      ]
    },
    // Отдельные «все», «никто», «всегда» в русском слишком обычны; ловятся только их усиленные связки.
    {
      "id": "RU-W7",
      "lang": "ru",
      "kind": "phrases",
      "severity": "note",
      "name": "Ложная крайность",
      "fix": "Ложная уверенность. Назовите, кто именно и как часто.",
      "items": [
        "все без исключения", "каждый без исключения", "никто и никогда", "всегда и везде", "абсолютно все",
        "абсолютно каждый", "ни один человек", "все и каждый"
      ]
    },
    {
      "id": "RU-W8",
      "lang": "ru",
      "kind": "phrases",
      "severity": "minor",
      "name": "Размытое «все»",
      "fix": "Назовите настоящую группу или уберите сравнение. Это рамка, а не факт.",
      "items": [
        "все мы знаем", "все знают", "каждый знает", "как все знают", "как известно", "многие компании",
        "большинство компаний", "большинство людей", "многие люди", "многие из нас", "каждый из нас",
        "вы наверняка слышали", "вы наверняка видели", "вы наверняка сталкивались", "вы наверняка знаете",
        "мы все сталкивались", "все мы сталкивались", "все мы помним", "никто не говорит о"
      ]
    },
    // «Это не X — это Y». Сильнее любого слова: шаблон ставят по структуре, а не по случаю. Обычное «не X,
    // а Y» в русском нормально и не ловится — только его заготовки.
    {
      "id": "RU-S1",
      "lang": "ru",
      "kind": "regex",
      "severity": "major",
      "name": "Отрицательный параллелизм",
      "fix": "Скажите утверждение один раз и прямо. Отрицание уберите целиком.",
      "patterns": [
        "(?<!\\p{L})(?:это|оно|он|она|они)\\s+не\\s+(?:просто\\s+|только\\s+|про\\s+)?[^.?!;\\n]{1,60}?\\s+[—–]\\s+(?:это|а)\\s",
        "(?<!\\p{L})не\\s+(?:просто|только\\s+лишь|лишь)\\s+[^.?!;\\n]{1,60}?,\\s*(?:а|это)\\s",
        "(?<!\\p{L})(?:дело|речь|вопрос|проблема|суть|секрет)\\s+не\\s+в\\s+[^.?!;\\n]{1,60}?[,—–]\\s*(?:а|дело|речь|проблема|суть)\\s",
        "(?<!\\p{L})это\\s+не\\s+про\\s+[^.?!;\\n]{1,60}?[.,—–]\\s*(?:это|а|оно)\\s+про\\s",
        "(?<!\\p{L})переста[её]т\\s+быть\\s+[^.?!;\\n]{1,40}?\\s+и\\s+становится",
        "(?<!\\p{L})не\\s+потому,?\\s+что\\s+[^.?!;\\n]{1,60}?\\.\\s+(?:а\\s+)?потому,?\\s+что"
      ]
    },
    {
      "id": "RU-S2",
      "lang": "ru",
      "kind": "regex",
      "severity": "major",
      "name": "Прочистка горла",
      "fix": "Вычеркните и скажите суть.",
      "patterns": [
        "(?<!\\p{L})давай(?:те)?\\s+(?:разбер[её]мся|посмотрим|рассмотрим|погрузимся|углубимся|начн[её]м|пройд[её]мся|будем\\s+честны|честно|представим)",
        "(?<!\\p{L})(?:скажу|буду)\\s+(?:честно|откровенно|прямо|откровенен|откровенна|честен|честна)",
        "(?<!\\p{L})вот\\s+в\\s+ч[её]м\\s+(?:дело|штука|фишка|подвох|суть|секрет|соль)",
        "(?<!\\p{L})вот\\s+что\\s+(?:важно|нужно\\s+знать|стоит\\s+знать|интересно|главное)",
        "(?<!\\p{L})неудобная\\s+правда",
