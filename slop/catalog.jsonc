        "\\b(?:the\\s+part|the\\s+thing|the\\s+bit)\\s+(?:that\\s+)?(?:most\\s+people\\s+|everyone\\s+|nobody\\s+)?(?:skips?|misses|gets?\\s+wrong)\\b",
        "\\bhere['’]?s\\s+what\\s+nobody\\s+tells\\s+you\\b",
