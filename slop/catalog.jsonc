    },
    {
      "id": "EN-S4",
      "lang": "en",
      "kind": "regex",
      "severity": "major",
      "name": "Rhetorical setup",
      "fix": "Make the point. Let the reader draw the conclusion.",
      "patterns": [
        "\\bthink\\s+about\\s+it[:.]",
        "\\bplot\\s+twist[:.]",
