      "fix": "State both things directly. The bookkeeping adds nothing the reader needed.",
      "patterns": [
        "\\b(?:that|this|it|\\w+)\\s+(?:is|was|'s)\\s+(?:only\\s+)?half\\s+(?:the|of)\\s+\\w+\\.\\s*the\\s+other\\s+half\\b",
        "\\bthe\\s+other\\s+half\\s+(?:is|was)\\b",
