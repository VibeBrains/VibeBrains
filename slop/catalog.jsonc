    {
      "id": "EN-S1",
      "lang": "en",
      "kind": "regex",
      "severity": "major",
      "name": "Negative parallelism",
      "fix": "State the positive claim once, directly. Drop the negation entirely.",
      "patterns": [
        "\\b(?:it|this|that|the\\s+\\w+)\\s+(?:is|was)n['’]?t\\s+(?:about\\s+)?[^.?!,;]{1,60}[,.]\\s*(?:it|that|this)['’]?s\\b",
        "\\bnot\\s+(?:just|only|merely|simply)\\s+[^.?!;]{1,60}\\bbut\\b",
        "\\bthe\\s+(?:question|problem|issue|answer|point|challenge|real\\s+\\w+)\\s+(?:is|was)n['’]?t\\b",
        "\\bnot\\s+because\\s+[^.?!;]{1,60}[.,]\\s*because\\b",
        "\\bit\\s+(?:feels|seems|looks|sounds)\\s+like\\s+[^.?!;]{1,60}[.,]\\s*(?:it['’]?s\\s+)?actually\\b",
