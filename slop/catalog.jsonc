      "id": "EN-D1",
      "lang": "en",
      "kind": "density",
      "severity": "major",
      "name": "Contrastive tail",
      "fix": "Defining each claim against what it is not. Drop the foil from at least half of these and let the positive statement stand.",
      "minCount": 3,
      "thresholdPer1000": 7.5,
      "patterns": [
