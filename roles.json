// ─────────────────────────────────────────────────────────────────────────────
//  .vibe/roles.json — умолчания ролей агента, общие для VibeIDE и VibeIDEA
//
//  Это РАБОЧИЙ файл. Формат JSONC: комментарии и висячие запятые разрешены.
//  Отдельный файл, а не раздел pipelines.json: роль зовут не только пайплайны,
//  но и оркестратор при делегировании.
//
//  roles.qa.writePaths — куда шаг qa пишет, если у шага нет своих "paths".
//  Синтаксис gitignore: `*` не переходит через `/`, `**` переходит,
//  шаблон без `/` действует на любой глубине.
//  Свои "paths" шага заменяют этот список, одни "denyPaths" его сужают.
//
//  Граница не расширяется от ошибки:
//  нет файла, файл битый или нет записи qa — действует вшитый в продукт список
//  пустой список [] — шагу qa запись запрещена целиком, а не разрешена везде
//
//  Полная спека: docs/vibe/manuals/rolesSpec.md
// ─────────────────────────────────────────────────────────────────────────────
{
  "version": 1,
  "roles": {
    "qa": {
      "writePaths": [
        "**/test/**", "**/tests/**", "**/testSrc/**", "**/testData/**", "**/__tests__/**", "**/spec/**",
        "*Test.kt", "*Test.java", "*Tests.kt", "*Test.php", "*.test.ts", "*.test.tsx", "*.test.js",
        "*.spec.ts", "*.spec.tsx", "*.spec.js", "test_*.py", "*_test.py", "*_test.go"
      ]
    }
  }
}
