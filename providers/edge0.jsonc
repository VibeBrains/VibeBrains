// Edge0-35B-A3B Preview — 35B на машине, где столько памяти нет.
//
// ИДЕЯ: смесь экспертов (256 на слой, активны 4) лежит на диске и читается по требованию через
// mmap, а отдельная голова предсказывает маршрутизацию на токен вперёд, чтобы чтение шло
// одновременно со счётом. Активная память при этом около 2.9 ГБ, веса на диске — 19.5–19.6 ГБ
// (huggingface.co/Edge0/Edge0-35B-A3B-preview, сверено 19.09.2026). Лицензия Apache-2.0.
//
// ⚠️ ТОЛЬКО APPLE SILICON И ТОЛЬКО СВОИМ РАНТАЙМОМ. Ни Ollama, ни LM Studio, ни llama.cpp эту
// модель не запускают: GGUF нет, бэкенд один — MLX. Сначала ставится их пакет, потом поднимается
// OpenAI-совместимый сервер, и только после этого запись ниже к чему-то подключается:
//
//   pip install -e 'git+https://github.com/Edge0-AI/edge0.git#egg=edge0[fetch]'
//   edge0 serve --port 8085
//
// ⚠️ СКОРОСТЬ: в карточке модели вендор называет 14.9–17.7 токена в секунду на Mac mini M4 Pro с
// 24 ГБ; цифра 20.4, которая ходит по пересказам, взята из статьи авторов, а не из карточки.
// Независимых замеров на 19.09.2026 не нашлось, а сами авторы предупреждают о разбросе между
// прогонами. Считайте порядок величины, а не обещание.
//
// ⚠️ КУДА ЕЁ НЕ СТАВИТЬ: 4-битная сборка теряет около 4 пунктов в среднем по бенчмаркам вендора и
// около 6 на задачах рассуждения. Планировщик, критик и ревьюер плана на такой модели ошибаются
// молча — берите её на чтение кода, разведку и черновики, а решения оставляйте сильной модели.
//
// Запись выключена: без запущенного сервера провайдер всё равно не ответит, а список моделей у
// выключенного провайдера не мозолит глаза. Включается тумблером "active": true.
{
  "version": 1,
  "providers": [
    {
      "id": "edge0",
      "name": "Edge0 35B (локально, Apple Silicon)",
      "active": false, // тумблер: false — провайдер скрыт из списков (в слиянии и extends участвует)
      "protocol": "openai",
      // Адрес по умолчанию у их сервера; порт меняется флагом --port.
      "baseURL": "http://localhost:8085/v1",
      // Ключ локальному серверу не нужен: он не проверяет заголовок авторизации.
      "order": 45,
      "models": {
        // Каталог сервер отдаёт сам — список подхватится после запуска.
        "fetch": true

        // Если каталог пуст (старая сборка сервера), объявите модель руками:
        // "static": [
        //   { "id": "Edge0-35B-A3B-preview", "name": "Edge0 35B A3B (4-bit)", "default": true,
        //     "contextWindow": 131072, "vision": false }
        // ]
      }
    }
  ]
}
