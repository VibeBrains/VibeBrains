// OpenCode Go — подписка OpenCode: фиксированная плата, модели Qwen, DeepSeek V4 и другие.
// Аккаунт тот же, что у OpenCode Zen; ключ один на оба провайдера (см. apiKeyRef ниже —
// введённый в настройках ключ подхватят и Go, и Zen). Взять ключ: opencode.ai/zen,
// список моделей Go: dev.opencode.ai/docs/go.
{
  "version": 1,
  "providers": [
    {
      "id": "opencode-go",
      "name": "OpenCode Go",
      "active": true, // тумблер: false — провайдер скрыт из списков (в слиянии и extends участвует)
      "protocol": "openai",
      "baseURL": "https://opencode.ai/zen/go/v1",
      "auth": "bearer",
      "apiKeyRef": "opencode", // один ключ на Go и Zen в защищённом хранилище
      "apiKeyEnv": "OPENCODE_API_KEY", // либо OPENCODE_API_KEY=... в .vibe/.env
      "order": 10,
      // ВАЖНО: у Go формат API привязан к МОДЕЛИ, а не к провайдеру (docs: opencode.ai/docs/go).
      // Провайдерский "protocol" выше — умолчание для тех, кто ниже ничего не сказал; MiniMax и
      // Qwen обслуживаются Anthropic-совместимым /v1/messages, поэтому у них свой "protocol".
      // Без этих строк автоматически подтянутый каталог зовёт половину моделей не тем протоколом.
      "models": {
        "fetch": true,
        "static": [
          { "id": "minimax-m3", "protocol": "anthropic" },
          { "id": "minimax-m2.7", "protocol": "anthropic" },
          { "id": "minimax-m2.5", "protocol": "anthropic" },
          { "id": "qwen3.8-max", "protocol": "anthropic" },
          { "id": "qwen3.8-flash", "protocol": "anthropic" },
          { "id": "qwen3.7-max", "protocol": "anthropic" },
          { "id": "qwen3.7-plus", "protocol": "anthropic" },
          { "id": "qwen3.6-plus", "protocol": "anthropic" },
          // Третий формат: /v1/responses. Это ОТДЕЛЬНЫЙ эндпоинт, а не диалект chat-completions —
          // модель оттуда отвечает 404 на /v1/chat/completions и наоборот.
          // ВНИМАНИЕ: маршрут покрыт типами и тестом, но живьём не проверялся — ключа с доступом
          // к этим моделям у нас не было. Если запрос не проходит, начните с проверки этого поля.
          { "id": "grok-4.6", "protocol": "openai-responses" },
          { "id": "gpt-5.6-luna", "protocol": "openai-responses" },
          { "id": "muse-spark-1.2-contributor", "protocol": "openai-responses" }
        ]
      }
    }
  ]
}
