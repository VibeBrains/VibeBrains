// OpenRouter — агрегатор: сотни моделей разных вендоров одним ключом по OpenAI-совместимому API.
// Каталог большой — лишнее удобно прятать в Settings → Tools → VibeIDEA → Модели.
// Ключ: openrouter.ai/settings/keys; лимиты: openrouter.ai/docs/api-reference/limits.
{
  "version": 1,
  "providers": [
    {
      "id": "openrouter",
      "name": "OpenRouter",
      "active": true, // тумблер: false — провайдер скрыт из списков (в слиянии и extends участвует)
      "protocol": "openai",
      "baseURL": "https://openrouter.ai/api/v1",
      "auth": "bearer",
      "apiKeyEnv": "OPENROUTER_API_KEY", // ключ: OPENROUTER_API_KEY=sk-or-... в .vibe/.env
      "order": 20,
      "models": { "fetch": true },
      // Рассуждение OpenRouter принимает одним объектом для всех моделей: "reasoning": {"effort": …},
      // а выключается оно {"effort": "none"} (openrouter.ai/docs/use-cases/reasoning-tokens, сверено 24.09.2026).
      // Поле reasoning_effort протокола OpenAI в его документации не упомянуто, поэтому провайдеру нужен свой
      // диалект. Оба продукта читают поле; у VibeIDE встроенный OpenRouter и так говорит этим диалектом, а поле
      // нужно провайдеру из файла, который смотрит в OpenRouter или в совместимый с ним роутер.
      "reasoningDialect": "openrouter"
    }
  ]
}
