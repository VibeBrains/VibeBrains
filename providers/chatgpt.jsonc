// ChatGPT по подписке — запросы оплачивает ваш план ChatGPT Plus или Pro, ключ API не нужен.
// Включите провайдер ("active": true) и войдите: Settings → Tools → VibeIDEA → Провайдеры,
// кнопка «Продолжить с ChatGPT». Вход идёт в браузере; регистрировать приложение не нужно —
// открытый клиент регистрируется сам при первом входе (developers.openai.com/siwc/token-sharing-open-source,
// сверено 01.10.2026). Предварительная версия вендора: правила маршрута могут меняться.
//
// Что отличает маршрут плана от API:
//   • только Responses ("protocol": "openai-responses"), только потоком и без хранения у вендора;
//   • запрос не принимает temperature, top_p, max_output_tokens, previous_response_id и ещё ряд полей —
//     IDE снимает их сама, а доктор называет поля extraBody, которые будут сняты;
//   • инструменты IDE уходят пространством имён "vibe";
//   • у Plus пятичасовой лимит общий со всеми приложениями плана, у Pro его нет; остаток квоты вендор
//     клиенту не сообщает — только страница chatgpt.com/settings/usage («Управлять лимитами»);
//   • исчерпанный лимит IDE называет и не уводит запросы на платный ключ сама.
//
// Несколько аккаунтов — несколько записей с разными метками: "auth": { "type": "chatgpt", "account": "<метка>" }.
// Метка — та, что видна в карточке провайдера после входа (обычно почта аккаунта).
{
  "version": 1,
  "providers": [
    {
      "id": "chatgpt",
      "name": "ChatGPT (подписка)",
      "active": false, // тумблер: true — провайдер появляется в списках
      "protocol": "openai-responses",
      "baseURL": "https://api.openai.com/v1",
      "auth": "chatgpt",
      "order": 35,
      // Каталог плана: GET /v1/models с токеном входа отдаёт модели, доступные аккаунту.
      "models": { "fetch": true }
    }
  ]
}
