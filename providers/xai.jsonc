// xAI (Grok) — OpenAI-совместимый API. Ключ: XAI_API_KEY=<ключ> в .vibe/.env
// (взять: console.x.ai).
//
// МОДЕЛЬ (docs.x.ai/developers/grok-4-7, сверено 22.09.2026):
//   • grok-4.7 — выпущена 21.09.2026, окно 500 000, ответ без объявленного потолка,
//     знания до мая 2026, вход текст и картинки. Инструменты: function calling,
//     веб-поиск, поиск по X, исполнение кода.
//   • Рассуждение — low / medium / high / xhigh, умолчание вендора high.
//
// ТОЧКА В ID ОБЯЗАТЕЛЬНА: модель называется ровно "grok-4.7". Вендор не принимает
// написание через дефис, а протокол «совместим с OpenAI» имён не нормализует.
//
// FAST-ВАРИАНТА ЗДЕСЬ НЕТ НАМЕРЕННО. Он стоит вдвое от базового и доступен только
// в Cursor и Grok Build — в публичном API xAI его нет, и запись о нём отвечала бы
// ошибкой на каждый запрос.
//
// КЭШ ПРОМПТА: вендор советует слать prompt_cache_key, иначе запрос может уехать на
// сервер без кэша и вход оплатится по полной цене. Значение ключа сюда не вписано: оно
// обязано быть стабильным НА РАЗГОВОР, а константа в общем сиде свела бы кэш
// к случайности у всех сразу. Файл лишь объявляет "promptCacheKey": true — «этот
// endpoint поле принимает», а ключ разговора подставляет клиент.
{
  "version": 1,
  "providers": [
    {
      "id": "xai",
      "name": "xAI (Grok)",
      "active": true, // тумблер: false — провайдер скрыт из списков (в слиянии и extends участвует)
      "protocol": "openai",
      "baseURL": "https://api.x.ai/v1",
      "auth": "bearer",
      "apiKeyEnv": "XAI_API_KEY",
      "promptCacheKey": true, // клиент шлёт prompt_cache_key, постоянный в пределах разговора
      "order": 72,
      "models": {
        "fetch": true,
        "static": [
          {
            "id": "grok-4.7",
            "name": "Grok 4.7 (500K)",
            "default": true,
            "pinned": true,
            "contextWindow": 500000,
            "reasoning": { "effort": ["low", "medium", "high", "xhigh"] },
            // Цена со страницы модели у вендора (docs.x.ai, сверено 22.09.2026).
            //
            // СТУПЕНЧАТАЯ ПО ДЛИНЕ ПРОМПТА: до 200K входных токенов — $2 и $6 за миллион,
            // от 200K — $4 и $12, то есть ровно вдвое (docs.x.ai/docs/models, таблица цен,
            // сверено 22.09.2026). Кэш-чтение дорожает так же: $0.50 → $1.00. Анонс модели
            // называет только нижнюю ступень, и по нему одному отчёт о расходе занижал бы счёт
            // вдвое — а в длинный контекст упирается именно агентный цикл, перечитывающий проект.
            "cost": {
              "input": 2, "output": 6, "cacheRead": 0.5,
              "longContext": { "overInputTokens": 200000, "input": 2, "cache": 2, "output": 2 }
            }
          }
        ]
      }
    }
  ]
}
