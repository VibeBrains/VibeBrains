// Anthropic (Claude) — прямой API по нативному протоколу Anthropic.
// Claude в VibeIDEA прежде всего живёт как ACP-агент (Claude Code) — с инструментами,
// сессиями и режимами; этот провайдер — для прямого чата с API, если есть свой ключ.
// Ключ: ANTHROPIC_API_KEY=<ключ> в .vibe/.env (взять: console.anthropic.com).
// Подписка Max даёт и ключ: с 07.10.2026 в Max 5x входит $100 в месяц на API, в Max 20x — $200, у Team — по
// местам. Это обычный ключ Console, он работает здесь как любой другой, но расход идёт деньгами по ценам ниже,
// а не лимитами подписки. Pro кредитов не получает (support.claude.com/en/articles/17154008, сверено 08.10.2026).
{
  "version": 1,
  "providers": [
    {
      "id": "anthropic",
      "name": "Anthropic (Claude)",
      "active": true, // тумблер: false — провайдер скрыт из списков (в слиянии и extends участвует)
      "protocol": "anthropic",
      "baseURL": "https://api.anthropic.com/v1",
      "auth": { "type": "header", "name": "x-api-key" },
      "apiKeyEnv": "ANTHROPIC_API_KEY",
      "order": 71,
      "models": {
        // Каталог у вендора есть — список моделей приезжает сам. Цен каталог НЕ
        // отдаёт, а своей таблицы у нас нет по принципу «цена — факт о вашем
        // договоре». Хотите видеть деньги в отчёте — раскомментируйте записи ниже.
        "fetch": true

        // ── Claude 5.1: цены и кэш (docs.claude.com/…/pricing, проверено 08.09.2026) ──
        // Чтение кэша у 5.1 стоит $0.25 за 1M — это 0.025 от входа, а не привычные
        // 0.1: длинная сессия с кэшем у них дешевле вчетверо против Fable 5.
        // "cacheTtl": "1h" — часовой кэш: запись дороже ($20 против $12.50 за 1M),
        // но пауза длиннее пяти минут (ревью, ожидание CI) перестаёт стоить полного
        // перечитывания. Ставится осознанно, умолчание вендора — 5 минут.
        // Цены записи две: "cacheWrite" — пять минут, "cacheWrite1h" — час; отчёт о расходе
        // берёт ту, что соответствует "cacheTtl". Без "cacheWrite1h" — двойная цена входа (правило Anthropic).
        // Токенизатор у моделей 4.7+ новый: тот же текст даёт примерно на 30%
        // больше токенов — старые бюджеты в токенах занижают счёт.
        // "static": [
        //   { "id": "claude-fable-5-1", "name": "Claude Fable 5.1", "default": true,
        //     // При "cacheTtl": "1h" запись кэша стоит $20, а не $12.50 — отчёт берёт "cacheWrite1h".
        //     "cost": { "input": 10, "output": 50, "cacheRead": 0.25, "cacheWrite": 12.5, "cacheWrite1h": 20, "currency": "USD" },
        //     "cacheTtl": "1h" },
        //   { "id": "claude-mythos-5-1", "name": "Claude Mythos 5.1 (по допуску)",
        //     "cost": { "input": 10, "output": 50, "cacheRead": 0.25, "cacheWrite": 12.5, "currency": "USD" } },
        //   { "id": "claude-opus-5", "name": "Claude Opus 5",
        //     "cost": { "input": 5, "output": 25, "cacheRead": 0.5, "cacheWrite": 6.25, "currency": "USD" } },
        //   // Claude Opus 5.5 (выпуск 22.09.2026; platform.claude.com/docs/en/about-claude/pricing и
        //   // /models/overview, сверено 23.09.2026): окно 1M, выход 128K, Opus 5 с этого дня в «прежних».
        //   // Чтение кэша $0.20 — 0.05 от входа; запись $5 на пять минут, $8 на час (с "cacheTtl": "1h").
        //   // МЫШЛЕНИЕ НЕ ВЫКЛЮЧАЕТСЯ: {"type": "disabled"} — 400, поле без значения — адаптивное
        //   // мышление на умолчании вендора, а оно у этой модели medium, а не high. Честно «выключено» у неё
        //   // может значить только самый низкий уровень усилия — low.
        //   // УСИЛИЕ: low, medium (умолчание), high, xhigh, max. Без объявления ползунок шлёт low / medium / high.
        //   // Верх до max открывает строка "reasoning": {"effort": ["low", "medium", "high", "xhigh", "max"]}:
        //   // тогда положения — low / high / max, середина уходит с умолчания вендора на high, а для xhigh и
        //   // max вендор советует max_tokens от 64K (platform.claude.com/docs/en/build-with-claude/effort,
        //   // сверено 24.09.2026: xhigh — для задач дольше 30 минут с бюджетом в миллионы токенов).
        //   { "id": "claude-opus-5-5", "name": "Claude Opus 5.5",
        //     "cost": { "input": 4, "output": 20, "cacheRead": 0.2, "cacheWrite": 5, "cacheWrite1h": 8, "currency": "USD" } },
        //   // Claude Sonnet 5.5 (выпуск 28.09.2026; platform.claude.com/docs/en/models/sonnet-5-5/overview и
        //   // /whats-new-sonnet-5-5, сверено 30.09.2026): окно 1M, выход 128K, $2 / $10, запись $2.50 на пять минут
        //   // и $4 на час. Чтение кэша с 07.10.2026 — $0.10, 0.05 от входа (было $0.20; /about-claude/pricing,
        //   // сверено 08.10.2026).
        //   // МЫШЛЕНИЕ НЕ ВЫКЛЮЧАЕТСЯ через {"type": "disabled"} — это 400 со ссылкой на {"type": "between_tools"}:
        //   // модель не думает перед ответом, только между вызовами инструментов. Его и шлёт положение «выключено»,
        //   // вместе с усилием low: between_tools принимается при low, medium и high, а без усилия действует
        //   // умолчание API — high. Принудительный вызов инструмента (tool_choice any/tool) — 400.
        //   { "id": "claude-sonnet-5-5", "name": "Claude Sonnet 5.5", "contextWindow": 1000000, "maxOutputTokens": 128000,
        //     "cost": { "input": 2, "output": 10, "cacheRead": 0.1, "cacheWrite": 2.5, "cacheWrite1h": 4, "currency": "USD" } },
        //   // Claude Haiku 5.5 (выпуск 07.10.2026; platform.claude.com/docs/en/models/haiku-5-5/overview и
        //   // /migration-guide, сверено 08.10.2026): окно 1M, выход 128K, мышление адаптивное и включено по умолчанию,
        //   // умолчание усилия — medium. ЦЕНА ЗАВИСИТ ОТ ДЛИНЫ ПРОМПТА: до 100 000 токенов $0.10 / $0.50, кэш $0.01,
        //   // запись $0.125 и $0.20; длиннее — всё ровно впятеро дороже, это и есть блок "longContext".
        //   // Положение «выключено» шлёт {"type": "disabled"}: модель принимает его при усилии до high, а выше
        //   // ползунок не поднимается. temperature, top_p и top_k — 400 на любом запросе. Принудительный вызов
        //   // инструмента принимается, но ответ тогда начинается с вызова, без мышления.
        //   { "id": "claude-haiku-5-5", "name": "Claude Haiku 5.5", "contextWindow": 1000000, "maxOutputTokens": 128000,
        //     "cost": { "input": 0.1, "output": 0.5, "cacheRead": 0.01, "cacheWrite": 0.125, "cacheWrite1h": 0.2, "currency": "USD",
        //       "longContext": { "overInputTokens": 100000, "input": 5, "cache": 5, "output": 5 } } }
        // ]
      }
    }
  ]
}
