// ARBR — самохостящийся шлюз к моделям (projectarbr.org): один OpenAI-совместимый
// эндпоинт поверх всех провайдеров, плюс роутинг, бюджеты и телеметрия на своей стороне.
//
// ПОЧЕМУ ЭТО ОБЫЧНЫЙ ПРОВАЙДЕР, А НЕ ОТДЕЛЬНАЯ ПОДСИСТЕМА IDE:
// шлюз говорит на том же протоколе, что и все остальные записи каталога, поэтому
// подключается одной записью — кода в IDE для него не нужно. Встраивать его В IDE мы
// намеренно не стали (решение №48): бюджеты в трёх окнах, аудит и реестр провайдеров у
// нас уже свои, а ключи живут в защищённом хранилище IDE и уходить в стороннюю службу
// не должны. Нужен общий на команду учёт — поднимите шлюз сами и укажите его здесь.
//
// baseURL — адрес ВАШЕЙ установки; публичного облака у проекта нет.
// Ключ: ARBR_API_KEY=<ключ> в .vibe/.env (его выдаёт ваш шлюз, а не вендор модели).
{
  "version": 1,
  "providers": [
    {
      "id": "arbr",
      "name": "ARBR (свой шлюз)",
      "active": false, // тумблер: true — провайдер появляется в списках
      "protocol": "openai",
      "baseURL": "http://localhost:8080/v1",
      "auth": "bearer",
      "apiKeyRef": "arbr",
      "apiKeyEnv": "ARBR_API_KEY",
      "order": 90,
      // Каталог отдаёт сам шлюз — список моделей будет тем, что вы ему разрешили.
      "models": { "fetch": true }
    }
  ]
}
