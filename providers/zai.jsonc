// Z.AI (Zhipu / GLM) — OpenAI-совместимый API.
// Ключ: ZAI_API_KEY=<ключ> в .vibe/.env (взять: z.ai/manage-apikey/apikey-list, дока: docs.z.ai).
//
// ТРИ РАЗНЫХ ЭНДПОИНТА — выберите тот, за который вы платите
// (docs.z.ai/devpack/quick-start, проверено первоисточником 09.09.2026):
//   • /api/coding/paas/v4 — GLM Coding Plan (подписка), OpenAI-совместимый. Ключ из раздела
//     «Model & Personal Coding Plan» работает ТОЛЬКО здесь. Это дефолт ниже.
//   • /api/paas/v4        — оплата за токены (pay-as-you-go): замените baseURL.
//   • /api/anthropic      — нативный протокол Anthropic (кодинг-план), блок в конце файла.
//
// Симптом перепутанного эндпоинта — не «неверный ключ», а HTTP 429 с кодом 1113
// «Insufficient balance or no resource package. Please recharge»: подписочный ключ ушёл
// на пер-токенный счёт, где денег нет (проверено живьём 06.08.2026; вендор подтверждает
// это же поведение в docs.z.ai/devpack/faq).
//
// ЧТО ДОСТУПНО В ПЛАНЕ: только glm-5.3 и glm-5.3-flash. Запросы к GLM-5.2 и GLM-5.1
// вендор автоматически переводит на GLM-5.3 — писать их именами смысла нет
// (docs.z.ai/devpack/overview).
//
// КАК РАСХОДУЕТСЯ КВОТА (окно 5 часов; кредиты Lite 2 000 / Pro 12 000 / Max 28 000).
// Множители на 10K токенов: glm-5.3 — вход 6.9, чтение кэша 1.7, выход 24;
// glm-5.3-flash — 2.3 / 0.56 / 8. Вне пиков (всё, кроме Пн–Пт 14:00–18:00 SGT) — половина.
// То есть выход дороже входа втрое с лишним: длинные ответы жгут план быстрее длинного
// контекста, и это единственное число, по которому стоит принимать решения.
{
  "version": 1,
  "providers": [
    {
      "id": "zai",
      "name": "Z.AI (GLM)",
      "active": true, // тумблер: false — провайдер скрыт из списков (в слиянии и extends участвует)
      "protocol": "openai",
      "baseURL": "https://api.z.ai/api/coding/paas/v4",
      "auth": "bearer",
      "apiKeyEnv": "ZAI_API_KEY",
      "order": 40,
      "models": {
        // Каталог на <baseURL>/models вендор НЕ ДОКУМЕНТИРУЕТ (сверено с quick-start и
        // HTTP-introduction 09.09.2026). Оставлено включённым: если каталог есть, список
        // приедет сам и будет свежее нашего. Если его нет — работать всё равно есть с чем,
        // потому что обе модели плана перечислены ниже статически.
        "fetch": true,
        // Статические записи МЕРЖАТСЯ с авто-списком по id: здесь только то, чего в каталоге нет.
        "static": [
          {
            "id": "glm-5.3",
            "name": "GLM-5.3",
            "default": true,
            // 1M контекста, выход до 128K, вход только текстовый; рассуждение всегда включено
            // и имеет три уровня (docs.z.ai/guides/llm/glm-5.3, проверено 09.09.2026).
            "contextWindow": 1000000,
            "maxOutputTokens": 131072,
            "vision": false,
            "reasoning": { "canTurnOff": false, "effort": ["low", "high", "max"] }
          },
          {
            // Стартовая акция −50% заканчивается 09.09.2026 в 24:00 UTC+8 = 16:00 UTC.
            // Дальше цена ровно вдвое выше, кэш — тоже (docs.z.ai/guides/overview/pricing).
            "id": "glm-5.3-flash",
            "cost": { "input": 0.075, "output": 0.25, "cacheRead": 0.015 },
            "costValidUntil": "2026-09-09T16:00:00Z",
            "costAfter": { "input": 0.15, "output": 0.50, "cacheRead": 0.03 },
            "costNote": "стартовая акция −50%, docs.z.ai/guides/overview/pricing"
          }
        ]
      }
    }

    // ── Z.AI (GLM) по нативному протоколу Anthropic (кодинг-план) ──────────────────
    // Маршрут ПОДТВЕРЖДЁН ДОКОЙ ВЕНДОРА (docs.z.ai/devpack/quick-start, 09.09.2026):
    // Anthropic Messages живёт на https://api.z.ai/api/anthropic.
    //
    // Почему ниже написано «/anthropic/v1», а в доке — «/anthropic»: это одно и то же место.
    // SDK Anthropic дописывает к базе «/v1/messages», а наш клиент — РОВНО «/messages»,
    // поэтому версионный сегмент у нас входит в baseURL. Полный URL совпадает.
    // (Урок MiniMax 06.08.2026: без /v1 запрос уходил на /anthropic/messages и вендор отвечал 404.)
    //
    // Каталога моделей на этом эндпоинте нет — список задаётся вручную.
    // Раскомментируйте блок целиком — вместе с ведущей запятой и скобками.
    // ,{
    //   "id": "zai-anthropic", "extends": "zai", "name": "Z.AI (Anthropic-протокол)",
    //   "protocol": "anthropic", "baseURL": "https://api.z.ai/api/anthropic/v1",
    //   "auth": { "type": "header", "name": "x-api-key" }, "order": 41,
    //   "models": { "fetch": false, "static": [
    //     { "id": "glm-5.3", "name": "GLM-5.3 (Anthropic)", "contextWindow": 1000000 },
    //     { "id": "glm-5.3-flash", "name": "GLM-5.3 Flash (Anthropic)" }
    //   ] }
    // }
    // Сведение о том, что квота этого маршрута расходуется быстрее обычного (3x в пик, 2x вне),
    // взято из сводки сообщества github.com/Alorse/cc-compatible-models и доками вендора
    // НЕ ПОДТВЕРЖДЕНО — в docs.z.ai/devpack/overview множители названы только по моделям.
  ]
}
