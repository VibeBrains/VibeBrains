// Z.AI (Zhipu / GLM) — OpenAI-совместимый API.
// Ключ: ZAI_API_KEY=<ключ> в .vibe/.env (взять: z.ai/manage-apikey/apikey-list, дока: docs.z.ai).
//
// ДВА РАЗНЫХ ЭНДПОИНТА — выберите тот, за который вы платите:
//   • /api/coding/paas/v4 — GLM Coding Plan (подписка). Ключ из раздела
//     «Model & Personal Coding Plan» работает ТОЛЬКО здесь. Это дефолт ниже.
//   • /api/paas/v4        — оплата за токены (pay-as-you-go): замените baseURL.
//
// Симптом перепутанного эндпоинта — не «неверный ключ», а HTTP 429 с кодом 1113
// «Insufficient balance or no resource package. Please recharge»: подписочный ключ ушёл
// на пер-токенный счёт, где денег нет (проверено живьём 06.08.2026).
{
  "version": 1,
  "providers": [
    {
      "id": "zai",
      "name": "Z.AI (GLM)",
      "active": true, // тумблер: false — провайдер скрыт из списков (в слиянии и extends участвует)
      "protocol": "openai",
      "baseURL": "https://api.z.ai/api/coding/paas/v4",
      "auth": "bearer",
      "apiKeyEnv": "ZAI_API_KEY",
      "order": 40,
      "models": { "fetch": true } // каталог у z.ai живёт на <baseURL>/models — ровно туда и ходим
    }

    // ── Z.AI (GLM) по нативному протоколу Anthropic (кодинг-план) ──────────────────
    // НЕ ПРОВЕРЕНО ПЕРВОИСТОЧНИКОМ: маршрут и имя модели взяты из сводной таблицы
    // сообщества github.com/Alorse/cc-compatible-models (сверено 08.09.2026), доками
    // вендора не подтверждены. Сверьтесь с его документацией, прежде чем полагаться.
    // baseURL обязан заканчиваться на /v1: клиент дописывает РОВНО «/messages»
    // (урок MiniMax 06.08.2026 — без /v1 вендор отвечает 404).
    // Каталога моделей на этих эндпоинтах, как правило, нет — модель задаётся вручную.
    // Раскомментируйте блок целиком — вместе с ведущей запятой и скобками.
    // ,{
    //   "id": "zai-anthropic", "extends": "zai", "name": "Z.AI (Anthropic-протокол)",
    //   "protocol": "anthropic", "baseURL": "https://api.z.ai/api/anthropic/v1",
    //   "auth": { "type": "header", "name": "x-api-key" }, "order": 41,
    //   "models": { "fetch": false, "static": [ { "id": "glm-5.1", "name": "GLM-5.1 (Anthropic)" } ] }
    // }
    // Квота этого маршрута у вендора расходуется быстрее обычного (заявлено 3x в часы
    // пика, 2x вне их) — тоже по сводке сообщества, не по доке.
  ]
}
