// MiniMax — два маршрута к одним моделям:
//   1) "minimax" — OpenAI-совместимый API (включён);
//   2) "minimax-anthropic" — клон через extends по нативному Anthropic-совместимому
//      эндпоинту вендора. Вендор сам советует этот маршрут: «Anthropic-Compatible is recommended
//      for prompt-cache benefits» (platform.minimax.io/docs/api-reference/text-anthropic-api,
//      сверено 19.09.2026) — то есть кэш промпта работает именно здесь. Побочно он обходит
//      расхождения OpenAI-слоя в вызове инструментов.
// Ключ один на оба: MINIMAX_API_KEY в .vibe/.env или поле в настройках.
//
// ДВА РАЗНЫХ КЛЮЧА, ОДИН И ТОТ ЖЕ АДРЕС. У MiniMax подписка и поштучная оплата различаются
// НЕ доменом, а префиксом ключа (platform.minimax.io/docs/token-plan/other-tools, 09.09.2026):
//   • sk-api-…  — pay-as-you-go, раздел Account / API Keys;
//   • sk-cp-…   — Token Plan (подписка), раздел Billing / Token Plan.
// Взаимозаменяемыми они не являются. Квота плана считается скользящими окнами (5 часов и
// неделя), неиспользованное не переносится (platform.minimax.io/docs/token-plan/intro).
//
// ДОМЕН ПРИВЯЗАН К АККАУНТУ, а не к вашему местоположению: международный — api.minimax.io,
// материковый Китай — api.minimax.cn (так в официальной инструкции вендора для Claude Code;
// в клиентах и обсуждениях при этом широко ходит api.minimaxi.com — с лишней «i»). Ключ и
// домен обязаны совпадать, иначе ответ будет «неверный ключ», а не «не тот адрес».
//
// ЧТО ЭНДПОИНТ МОЛЧА ИГНОРИРУЕТ (platform.minimax.io/docs/api-reference/text-anthropic-api):
// top_k, stop_sequences, mcp_servers, context_management, container. Задавать их в записи
// бесполезно — маршрут выбросит их без ошибки. ИНАЧЕ С temperature: она принимается только из
// диапазона [0, 2], и за его пределами маршрут отвечает ОШИБКОЙ, а не молчанием (там же, сверено
// 14.09.2026). Причудой каталога это не описать — причуды сопоставляются по id модели, а не по
// маршруту (решение №62). Плюс требование вендора: в многоходовых диалогах
// с вызовом инструментов ответ ассистента обязан целиком возвращаться в историю.
{
  "version": 1,
  "providers": [
    {
      "id": "minimax",
      "name": "MiniMax",
      "active": true, // тумблер: false — провайдер скрыт из списков (в слиянии и extends участвует)
      "protocol": "openai",
      "baseURL": "https://api.minimax.io/v1",
      "auth": "bearer",
      "apiKeyRef": "minimax", // общий ref: ключ из настроек достаётся и Anthropic-клону ниже
      "apiKeyEnv": "MINIMAX_API_KEY",
      "order": 30,
      "models": { "fetch": true },
      // Остаток Token Plan — официальный запрос вендора (platform.minimax.io/docs/token-plan/faq). IDE задаёт его
      // только когда вы просите отчёт о расходе (/spend, «Расходы»), и показывает ответ вендора, а не свой подсчёт.
      // Смысл полей ответа вендор не документирует; IDE читает их так же, как его собственный CLI
      // (github.com/MiniMax-AI/cli, сверено 17.09.2026). С ключом поштучной оплаты (sk-api-…) остатка нет —
      // вендор ответит ошибкой, и её покажет отчёт; уберите поле, если платите поштучно.
      // Anthropic-клон ниже наследует поле через extends; одна подписка спрашивается один раз.
      "quota": { "url": "https://api.minimax.io/v1/token_plan/remains", "format": "minimax-token-plan" }
    },

    // ── MiniMax по нативному протоколу Anthropic ──────────────────────────────
    // ВНИМАНИЕ: baseURL обязан заканчиваться на /v1 — клиент дописывает РОВНО
    // «/messages» (проверено живьём 06.08.2026: без /v1 запрос уходил на
    // /anthropic/messages и вендор отвечал 404). Каталога моделей на этом эндпоинте
    // нет — модель задана записью ниже.
    {
      "id": "minimax-anthropic",
      "extends": "minimax",
      "name": "MiniMax (Anthropic-протокол)",
      "active": true, // тумблер: false — провайдер скрыт из списков (в слиянии и extends участвует)
      "protocol": "anthropic",
      "baseURL": "https://api.minimax.io/anthropic/v1",
      "auth": { "type": "header", "name": "x-api-key" },
      "apiKeyRef": "minimax", // тот же ключ, что у основного маршрута
      "order": 31,
      "models": {
        // Каталога на этом эндпоинте нет, поэтому список задаётся здесь.
        "fetch": false,
        "static": [
          {
            // Окно задано ВРУЧНУЮ: каталога на этом маршруте нет, спросить окно не у кого. Вендор
            // объявляет для MiniMax-M3 1 000 000 токенов, для линейки M2.x — 204 800
            // (platform.minimax.io/docs/api-reference/text-anthropic-api, сверено 11.09.2026).
            // Id — БЕЗ суффикса: в справочнике API модель называется MiniMax-M3. Суффикс [1m] из
            // инструкции вендора для Claude Code — пометка самого Claude Code: по ней он выбирает
            // миллионное окно и срезает её перед запросом (code.claude.com/docs/en/model-config,
            // сверено 11.09.2026). Нужна она только там, где MiniMax стоит за ACP-агентом Claude
            // Code; окно ему задаёт CLAUDE_CODE_MAX_CONTEXT_TOKENS. «Anthropic-слой отдаёт 200000» —
            // это окно, которое Claude Code предполагает для незнакомого id, а не поле вендора.
            "id": "MiniMax-M3",
            "name": "MiniMax M3 (Anthropic, 1M)",
            "default": true,
            "contextWindow": 1000000,
            "toolFormat": "anthropic"
          }

          // ── Остальные модели маршрута ──────────────────────────────────────────
          // Каталога на этом эндпоинте нет, поэтому спросить их не у кого: список взят из
          // справочника вендора (platform.minimax.io/docs/api-reference/text-anthropic-api,
          // сверено 19.09.2026). Окно у всей линейки M2.x — 204 800 токенов.
          // Модели с суффиксом `-highspeed` — быстрый вариант той же модели у вендора.
          // Раскомментируйте нужные вместе с ведущей запятой.
          // ,{ "id": "MiniMax-M2.7", "name": "MiniMax M2.7 (Anthropic)", "contextWindow": 204800, "toolFormat": "anthropic" }
          // ,{ "id": "MiniMax-M2.7-highspeed", "name": "MiniMax M2.7 highspeed (Anthropic)", "contextWindow": 204800, "toolFormat": "anthropic" }
          // ,{ "id": "MiniMax-M2.5", "name": "MiniMax M2.5 (Anthropic)", "contextWindow": 204800, "toolFormat": "anthropic" }
          // ,{ "id": "MiniMax-M2.1", "name": "MiniMax M2.1 (Anthropic)", "contextWindow": 204800, "toolFormat": "anthropic" }
        ]
      }
    }
  ]
}
