// Sakana Fugu — модель-оркестратор с OpenAI-совместимым API: она сама выбирает исполнителя
// из своего пула, и его работа оплачивается вашими токенами как обычный ввод-вывод.
// Ключ: SAKANA_API_KEY=<ключ> в .vibe/.env (взять: console.sakana.ai).
//
// РАЗМЫШЛЕНИЕ ОБЯЗАТЕЛЬНОЕ, и лестница у него своя: high | xhigh.
// Значение max принимается для совместимости и означает xhigh; отдельный max есть
// только у fugu-ultra-v1.1. Значения low и medium API отвергает ошибкой.
// Дефолт: high у fugu-max, xhigh у fugu-ultra (это и есть Ultra v2).
// Проверено 12.09.2026 по console.sakana.ai/get-started и живому каталогу OpenRouter.
//
// СЧЁТ БОЛЬШЕ ВИДИМОГО: токены оркестрации биллятся как обычные, разбивка приходит
// в usage.token_details. По стороннему разбору — от ~1300 токенов на простой запрос
// до 6–20 тысяч на сложный, поэтому оценка «по видимым токенам» занижает счёт.
//
// У fugu-ultra цена ступенчатая: выше 272K токенов ввода ставки удваиваются
// ($5/$30 → $10/$45 за миллион). VibeIDE ступень пока не считает — учтите при оценке.
//
// Стрим буферизованный: ответ приходит целиком, после всех внутренних вызовов.
{
  "version": 1,
  "providers": [
    {
      "id": "sakana",
      "name": "Sakana (Fugu)",
      "active": true, // тумблер: false — провайдер скрыт из списков (в слиянии и extends участвует)
      "protocol": "openai",
      "baseURL": "https://api.sakana.ai/v1",
      "auth": "bearer",
      "apiKeyEnv": "SAKANA_API_KEY",
      "order": 65,
      "models": {
        "fetch": true // id моделей приходят из каталога провайдера: fugu-max, fugu-ultra, sakana-namazu и прочие
      }
    }
  ]
}
