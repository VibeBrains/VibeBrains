// Alibaba Cloud AI Coding Plan — один ключ на четыре семейства (Qwen, GLM, Kimi, MiniMax).
// Подписка: лимит считается в ЗАПРОСАХ (6 000 за 5 часов, 45 000 в неделю, 90 000 в месяц),
// поэтому «дорогая» модель стоит столько же, сколько дешёвая.
// Ключ: DASHSCOPE_API_KEY=sk-sp-... в .vibe/.env — это ключ ПЛАНА (он отличается от обычного
// ключа Model Studio и начинается с sk-sp-). Взять: консоль Coding Plan → API key.
//
// ТРИ ВЕЩИ, О КОТОРЫХ ЛЕГКО СПОТКНУТЬСЯ:
//  1. Список моделей ВШИТ НИЖЕ НАМЕРЕННО — единственное такое исключение в каталоге.
//     Каталог /models у плана врёт: возвращает модели, которых в плане нет, а имена
//     сверяются ПОСИМВОЛЬНО (в плане именно kimi-k2.5 и MiniMax-M2.5 — свежих K3/M3 НЕТ,
//     сколько бы их ни было у самих вендоров).
//  2. GLM без "tool_stream" молча не вызывает инструменты: DashScope возвращает tool_calls
//     для GLM только при extraBody {"tool_stream": true}. Иначе модель отвечает прозой, и
//     выглядит это как «модель тупит», а не как ошибка. Поэтому extraBody у обеих GLM ниже.
//  3. Условия плана запрещают неинтерактивные сценарии (automated scripts, backends).
//     Работа в редакторе подходит; фоновые агенты и запуски по расписанию — нет: для них
//     берите обычный ключ Model Studio с оплатой за токены.
{
  "version": 1,
  "providers": [
    {
      "id": "alibaba-coding",
      "name": "Alibaba Coding Plan",
      "active": true, // тумблер: false — провайдер скрыт из списков (в слиянии и extends участвует)
      "protocol": "openai",
      "baseURL": "https://coding-intl.dashscope.aliyuncs.com/v1",
      "auth": "bearer",
      "apiKeyEnv": "DASHSCOPE_API_KEY",
      "order": 80,
      "models": {
        "fetch": true, // см. пункт 1 в шапке: каталог плана возвращает лишнее
        "static": [
          { "id": "qwen3.7-plus", "name": "Qwen 3.7 Plus", "default": true, "pinned": true, "contextWindow": 1000000 },
          { "id": "qwen3-coder-next", "name": "Qwen 3 Coder Next", "contextWindow": 1000000 },
          // Без extraBody GLM не вернёт ни одного tool_call — см. пункт 2 в шапке.
          { "id": "glm-5", "name": "GLM-5", "contextWindow": 204800, "extraBody": { "tool_stream": true } },
          { "id": "glm-4.7", "name": "GLM-4.7", "contextWindow": 204800, "extraBody": { "tool_stream": true } },
          { "id": "kimi-k2.5", "name": "Kimi K2.5", "contextWindow": 262144 },
          { "id": "MiniMax-M2.5", "name": "MiniMax M2.5", "contextWindow": 204800 }
        ]
      }
    }

    // ── DashScope (Qwen) по нативному протоколу Anthropic (кодинг-план) ──────────────────
    // НЕ ПРОВЕРЕНО ПЕРВОИСТОЧНИКОМ: маршрут и имя модели взяты из сводной таблицы
    // сообщества github.com/Alorse/cc-compatible-models (сверено 08.09.2026), доками
    // вендора не подтверждены. Сверьтесь с его документацией, прежде чем полагаться.
    // baseURL обязан заканчиваться на /v1: клиент дописывает РОВНО «/messages»
    // (урок MiniMax 06.08.2026 — без /v1 вендор отвечает 404).
    // Каталога моделей на этих эндпоинтах, как правило, нет — модель задаётся вручную.
    // Раскомментируйте блок целиком — вместе с ведущей запятой и скобками.
    // ,{
    //   "id": "dashscope-anthropic", "extends": "alibaba-coding", "name": "DashScope (Anthropic-протокол)",
    //   "protocol": "anthropic", "baseURL": "https://dashscope-intl.aliyuncs.com/apps/anthropic/v1",
    //   "auth": { "type": "header", "name": "x-api-key" }, "order": 81,
    //   "models": { "fetch": false, "static": [ { "id": "qwen3.6-plus", "name": "Qwen 3.6 Plus (Anthropic)" } ] }
    // }
    // Тариф у вендора считается полосами контекста (0–256K и 256K–1M) — цена одной
    // и той же модели зависит от длины запроса.
  ]
}
